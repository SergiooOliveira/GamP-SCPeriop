@page "/my-profile"
@attribute [Authorize(Roles = "Supervisionado")]
@using GamP_SCPeriop.Shared.Data
@using GamP_SCPeriop.Shared.Entity.Model
@using GamP_SCPeriop.Shared.Enum
@layout TopNavBarLayout
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11 mt-3 px-2">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <h4 class="fw-bold mb-0" style="color: #2c3e50;">Os Meus Percursos</h4>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="input-group input-group-sm shadow-sm" style="max-width: 250px;">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0"
                               placeholder="Procurar por nome..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>

                    <div class="dropdown position-relative">
                        <button class="btn btn-sm shadow-sm w-100 text-start d-flex justify-content-between align-items-center"
                                type="button" @onclick="ToggleDropdown"
                                style="min-width: 160px; background-color: white; border: 1px solid #dee2e6; color: #495057;">
                            <span><i class="bi bi-funnel me-1"></i> @currentTab</span>
                        </button>

                        @if (isDropdownOpen)
                        {
                            <!-- Um fundo invisível para fechar o dropdown se clicares fora -->
                            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="ToggleDropdown"></div>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 show" style="font-size: 0.9rem; position: absolute; right: 0; top: 100%; z-index: 1050;">
                                <li><button class="dropdown-item @(currentTab == "Todas" ? "active" : "")" @onclick='() => SelectTab("Todas")'>Todas</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item @(currentTab == "A decorrer" ? "active" : "")" @onclick='() => SelectTab("A decorrer")'>A decorrer</button></li>
                                <li><button class="dropdown-item @(currentTab == "Por iniciar" ? "active" : "")" @onclick='() => SelectTab("Por iniciar")'>Por iniciar</button></li>
                                <li><button class="dropdown-item @(currentTab == "Histórico" ? "active" : "")" @onclick='() => SelectTab("Histórico")'>Histórico</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item @(currentTab == "Com estrela" ? "active" : "")" @onclick='() => SelectTab("Com estrela")'>
                                        <i class="bi bi-star-fill text-warning me-2"></i>Com estrela
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger @(currentTab == "Removidos" ? "active" : "")" @onclick='() => SelectTab("Removidos")'>
                                        <i class="bi bi-eye-slash me-2"></i>Removidos
                                    </button>
                                </li>
                            </ul>
                        }
                    </div>

                    @if (enrollments != null && enrollments.Any() && currentUser != null)
                    {
                        <a href="api/Evaluation/student/@currentUser.Id/pdf" target="_blank" class="btn btn-sm text-white fw-bold shadow-sm" style="background-color: #6A96A6; white-space: nowrap;">
                            <i class="bi bi-filetype-pdf me-2 fs-6 align-middle"></i>Exportar Relatório
                        </a>
                    }
                </div>
            </div>

            @if (enrollments == null)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (!FilteredEnrollments.Any())
            {
                <div class="text-center mt-5 p-5 bg-light rounded-4 border-dashed">
                    <i class="bi bi-search text-muted mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold text-secondary">Nenhum percurso encontrado</h5>
                    <p class="text-muted small">Não existem percursos que correspondam à pesquisa ou filtros selecionados.</p>
                </div>
            }
            else
            {
                <div class="row g-4 mb-5">
                    @foreach (var enrollment in FilteredEnrollments)
                    {
                        var approvalScore = enrollment.ProgressPercentage;

                        // 2. Está concluído? (Sim, se tudo estiver avaliado OU a data tiver passado)
                        var isCompleted = enrollment.IsFullyEvaluated || enrollment.LimitDate < DateTime.UtcNow;

                        // 3. Foi aprovado? (Usa o score mínimo do percurso, ou 65 por defeito)
                        var minScore = enrollment.MinimumApprovalScore > 0 ? enrollment.MinimumApprovalScore : 65;
                        var isApproved = approvalScore >= minScore;

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card shadow-sm border-0 h-100"
                                 style="border-radius: 16px; transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;"
                                 onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';"
                                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.125rem 0.25rem rgba(0,0,0,0.075)';"
                                 @onclick='() => Nav.NavigateTo($"/pathway/{enrollment.PathwayId}")'>

                                <div class="card-body p-4 d-flex flex-column bg-white" style="border-radius: 16px;">

                                    <!-- Cabeçalho (Título e Botões) -->
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h5 class="fw-bold text-dark mb-0 pe-2" style="font-size: 1.1rem; border-left: 4px solid #6A96A6; padding-left: 8px;">
                                            @enrollment.PathwayTitle
                                        </h5>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-link p-0 border-0 text-warning" @onclick:stopPropagation="true" @onclick="() => ToggleStar(enrollment)">
                                                <i class="bi @(enrollment.IsStarred ? "bi-star-fill" : "bi-star") fs-5"></i>
                                            </button>
                                            <button class="btn btn-sm btn-link p-0 border-0 text-secondary" @onclick:stopPropagation="true" @onclick="() => ToggleHidden(enrollment)" title="@(enrollment.IsHidden ? "Restaurar" : "Ocultar")">
                                                <i class="bi @(enrollment.IsHidden ? "bi-eye" : "bi-eye-slash") fs-5"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Datas e Supervisor -->
                                    <div class="mb-4">
                                        <div class="text-muted small mb-1">
                                            <i class="bi bi-person-badge me-2"></i>Supervisor: @(enrollment.ProfessorName ?? "Atribuído")
                                        </div>
                                        <div class="text-muted small">
                                            <i class="bi bi-calendar-event me-2"></i>Limite: @(enrollment.LimitDate?.ToString("dd MMM yyyy") ?? "A definir")
                                        </div>
                                    </div>

                                    <!-- Zona de Estatísticas e Progresso -->
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center gap-2 mb-1">

                                            @if (isCompleted)
                                            {
                                                <!-- Se terminou (por data ou preenchimento total), diz se Aprovou ou Reprovou -->
                                                <small class="fw-bold" style="color: @(isApproved ? "#198754" : "#dc3545");">
                                                    <i class="bi @(isApproved ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                                    @(isApproved ? "Concluído (Aprovado)" : "Concluído (Reprovado)")
                                                </small>
                                            }
                                            else if (!enrollment.StartDate.HasValue)
                                            {
                                                <!-- Se ainda falta preencher e está dentro do prazo -->
                                                <small class="fw-bold text-warning">
                                                    <i class="bi bi-clock-history me-1"></i>Pendente
                                                </small>
                                            }
                                            else if (enrollment.StartDate > DateTime.UtcNow)
                                            {
                                                <small class="fw-bold text-secondary">
                                                    <i class="bi bi-clock me-1"></i>Por iniciar
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="fw-bold" style="color: #6A96A6;">
                                                    <i class="bi bi-clock-history me-1"></i>Em curso
                                                </small>
                                            }

                                            <small class="text-muted fw-bold">@(approvalScore)% Aprovação</small>
                                        </div>

                                        <!-- A barra visual pintada conforme o estado -->
                                        <div class="bg-light shadow-inner mb-3" style="height: 8px; border-radius: 10px; overflow: hidden;">
                                            <div class="h-100" style="width: @(approvalScore)%;
                                                background-color: @(isCompleted ? (isApproved ? "#198754" : "#dc3545") : "#6A96A6");
                                                transition: width 0.5s ease-in-out;">
                                            </div>
                                        </div>

                                        <div class="text-end text-primary small fw-semibold">
                                            Ver Detalhes <i class="bi bi-arrow-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public User? currentUser { get; set; }

    private bool isDropdownOpen = false;
    private List<StudentDashboardCardDTO>? enrollments;

    private string currentTab = "A decorrer";
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            enrollments = await Http.GetFromJsonAsync<List<StudentDashboardCardDTO>>($"api/Enrollment/student/{currentUser!.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Critical error: {ex.Message}");
        }
    }

    private IEnumerable<StudentDashboardCardDTO> FilteredEnrollments
    {
        get
        {
            if (enrollments == null) return Enumerable.Empty<StudentDashboardCardDTO>();

            var now = DateTime.UtcNow;
            var query = enrollments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(e => !string.IsNullOrEmpty(e.PathwayTitle) &&
                                    e.PathwayTitle.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            // ATENÇÃO: Substituímos o CalculateGlobalProgress == 100 pelo IsFullyEvaluated
            return currentTab switch
            {
                "Todas" => query.Where(e => !e.IsHidden),
                "Por iniciar" => query.Where(e =>  !e.IsHidden && e.StartDate > now),
                "A decorrer" => query.Where(e => !e.IsHidden && e.StartDate <= now && e.LimitDate >= now && !e.IsFullyEvaluated),
                "Histórico" => query.Where(e => e.LimitDate < now || e.IsFullyEvaluated || e.IsArchived),
                "Com estrela" => query.Where(e => !e.IsHidden && e.IsStarred),
                "Removidos" => query.Where(e => e.IsHidden),
                _ => query.Where(e => !e.IsHidden)
            };
        }
    }

    private async Task ToggleStar(StudentDashboardCardDTO e)
    {
        e.IsStarred = !e.IsStarred;
        await Http.PutAsJsonAsync($"api/Enrollment/{e.EnrollmentId}/star", e.IsStarred);
    }

    private async Task ToggleHidden(StudentDashboardCardDTO e)
    {
        e.IsHidden = !e.IsHidden;
        await Http.PutAsJsonAsync($"api/Enrollment/{e.EnrollmentId}/hidden", e.IsHidden);
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void SelectTab(string tab)
    {
        currentTab = tab;
        isDropdownOpen = false; // Fecha o dropdown ao selecionar
    }
}
@page "/my-profile"
@attribute [Authorize(Roles = "Supervisionado")]
@using GamP_SCPeriop.Shared.Data
@using GamP_SCPeriop.Shared.Entity.Model
@layout TopNavBarLayout
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11 px-2">

            <!-- Top Bar -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <h3 class="fw-bold text-dark mb-0">Os Meus Percursos</h3>

                <div class="d-flex flex-wrap gap-2 align-items-center">

                    <!-- Pesquisa -->
                    <div class="input-group shadow-sm" style="width: 250px; border-radius: 10px; overflow: hidden;">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-0 bg-white shadow-none" placeholder="Procurar por nome..." @bind="searchTerm" @bind:event="oninput">
                    </div>

                    <!-- Filtro Dropdown (Mantido o teu original mas com novo estilo) -->
                    <div class="dropdown position-relative">
                        <button class="btn bg-white shadow-sm d-flex justify-content-between align-items-center text-muted"
                                type="button" @onclick="ToggleDropdown"
                                style="min-width: 160px; border: 0; border-radius: 10px;">
                            <span><i class="bi bi-funnel me-1"></i> @currentTab</span>
                        </button>

                        @if (isDropdownOpen)
                        {
                            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="ToggleDropdown"></div>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 show" style="font-size: 0.9rem; position: absolute; right: 0; top: 100%; z-index: 1050; border-radius: 10px;">
                                <li><button class="dropdown-item @(currentTab == "Todas" ? "active" : "")" @onclick='() => SelectTab("Todas")'>Todas</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item @(currentTab == "A decorrer" ? "active" : "")" @onclick='() => SelectTab("A decorrer")'>A decorrer</button></li>
                                <li><button class="dropdown-item @(currentTab == "Por iniciar" ? "active" : "")" @onclick='() => SelectTab("Por iniciar")'>Por iniciar</button></li>
                                <li><button class="dropdown-item @(currentTab == "Histórico" ? "active" : "")" @onclick='() => SelectTab("Histórico")'>Histórico</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item @(currentTab == "Com estrela" ? "active" : "")" @onclick='() => SelectTab("Com estrela")'>
                                        <i class="bi bi-star-fill" style="color: var(--star);"></i> Com estrela
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger @(currentTab == "Removidos" ? "active" : "")" @onclick='() => SelectTab("Removidos")'>
                                        <i class="bi bi-eye-slash me-2"></i> Removidos
                                    </button>
                                </li>
                            </ul>
                        }
                    </div>

                    <!-- Exportar -->
                    @if (enrollments != null && enrollments.Any() && currentUser != null)
                    {
                        <a href="api/Evaluation/student/@currentUser.Id/pdf" target="_blank" class="btn btn-outline-secondary fw-semibold shadow-sm px-3" style="border-radius: 10px;">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Exportar Relatório
                        </a>
                    }
                </div>
            </div>

            @if (enrollments == null)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (!FilteredEnrollments.Any())
            {
                <div class="text-center mt-5 p-5 bg-white rounded-4 border-0 shadow-sm">
                    <i class="bi bi-search text-muted mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold text-dark">Nenhum percurso encontrado</h5>
                    <p class="text-muted small">Não existem percursos que correspondam à pesquisa ou filtros selecionados.</p>
                </div>
            }
            else
            {                
                <!-- Grid de Cartões -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
                    @foreach (var enrollment in FilteredEnrollments)
                    {
                        string status = GetStatusString(enrollment);
                        var theme = GetStatusTheme(status);

                        // Lógica de Urgência (Faltam menos de 7 dias)
                        bool isCompleted = status.Contains("Concluído");
                        bool isUrgent = !isCompleted && enrollment.LimitDate.HasValue && (enrollment.LimitDate.Value - DateTime.UtcNow).TotalDays is <= 7 and >= 0;

                        <div class="col">
                            <!-- Adicionada a borda esquerda com a variável da cor do tema -->
                            <div class="pcard card h-100" style="border-left: 5px solid var(--@theme.ColorVar) !important;" @onclick='() => Nav.NavigateTo($"/pathway/{enrollment.PathwayId}")'>
                                <div class="card-body p-4 d-flex flex-column bg-white">

                                    <!-- Cabeçalho do Cartão -->
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <!-- Removido o 'card-title-bordered' e adicionado cor de texto manual -->
                                        <h5 class="fw-bold mb-0 pe-2 line-clamp-2" style="font-size: 1.1rem; color: var(--ink);">
                                            @enrollment.PathwayTitle
                                        </h5>
                                        <div class="d-flex gap-2 flex-shrink-0">
                                            <button class="btn btn-sm btn-link p-0 border-0" @onclick:stopPropagation="true" @onclick="() => ToggleStar(enrollment)">
                                                <i class="bi @(enrollment.IsStarred ? "bi-star-fill" : "bi-star") fs-5 transition-all hover-icon" style="color: @(enrollment.IsStarred ? "var(--star)" : "var(--ink-soft)");" title="Destacar"></i>
                                            </button>
                                            <button class="btn btn-sm btn-link p-0 border-0" @onclick:stopPropagation="true" @onclick="() => ToggleHidden(enrollment)">
                                                <i class="bi @(enrollment.IsHidden ? "bi-eye" : "bi-eye-slash") fs-5 transition-all hover-icon" style="color: var(--ink-soft);" title="@(enrollment.IsHidden ? "Restaurar" : "Ocultar")"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Metadados (Supervisor e Data) -->
                                    <div class="mb-3 d-flex flex-column gap-1">
                                        <div class="small fw-medium" style="color: var(--ink-soft);">
                                            <i class="bi bi-person-badge me-2"></i>Supervisor: <span style="color: var(--ink);">@(enrollment.ProfessorName ?? "Atribuído")</span>
                                        </div>
                                        <div class="small fw-medium @(isUrgent ? "text-danger fw-bold" : "")" style="color: var(--ink-soft);">
                                            <i class="bi bi-calendar-event me-2"></i>Limite: <span style="color: @(isUrgent ? "var(--reproved)" : "var(--ink)");">@(enrollment.LimitDate?.ToString("dd MMM yyyy") ?? "A definir")</span>
                                        </div>
                                    </div>

                                    <!-- Status e Progresso -->
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge-status @theme.BadgeClass">
                                                <i class="bi @theme.Icon me-1"></i> @status
                                            </span>
                                            <small class="fw-semibold font-monospace" style="color: var(--ink-soft);">@enrollment.ProgressPercentage% Aprovação</small>
                                        </div>

                                        <!-- Barra de Progresso -->
                                        <div class="bar-track mb-3 shadow-sm">
                                            <div class="@theme.BarClass" style="height: 100%; width: @enrollment.ProgressPercentage%; transition: width 0.4s ease;"></div>
                                        </div>

                                        <!-- Ver detalhes -->
                                        <div class="text-end small fw-bold" style="color: var(--brand-dark);">
                                            Ver Detalhes <i class="bi bi-arrow-right ms-1"></i>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public User? currentUser { get; set; }

    private bool isDropdownOpen = false;
    private List<StudentDashboardCardDto>? enrollments;

    private string currentTab = "A decorrer";
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            enrollments = await Http.GetFromJsonAsync<List<StudentDashboardCardDto>>($"api/Enrollment/student/{currentUser.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Critical error: {ex.Message}");
        }
    }

    private IEnumerable<StudentDashboardCardDto> FilteredEnrollments
    {
        get
        {
            if (enrollments == null) return Enumerable.Empty<StudentDashboardCardDto>();

            var now = DateTime.UtcNow;
            var query = enrollments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(e => !string.IsNullOrEmpty(e.PathwayTitle) &&
                                    e.PathwayTitle.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            // TODO: Strange things happening
            return currentTab switch
            {
                "Todas" => query
                    .Where(e => !e.IsHidden)
                    .OrderBy(e => e.LimitDate),

                "Por iniciar" => query
                    .Where(e => !e.IsHidden && 
                                !e.IsArchived &&
                                (!e.StartDate.HasValue || e.StartDate > now))
                    .OrderBy(e => e.LimitDate),

                "A decorrer" => query
                    .Where(e => !e.IsHidden &&
                                !e.IsArchived &&
                                e.StartDate.HasValue && e.StartDate <= now &&
                                (!e.LimitDate.HasValue || e.LimitDate >= now || !e.AllModulesScheduled))
                    .OrderBy(e => e.LimitDate),

                "Histórico" => query
                    .Where(e => !e.IsHidden && 
                                (e.IsArchived || (e.AllModulesScheduled && e.LimitDate.HasValue && e.LimitDate < now)))
                    .OrderBy(e => e.LimitDate),

                "Com estrela" => query
                    .Where(e => !e.IsHidden && e.IsStarred)
                    .OrderBy(e => e.LimitDate),

                "Removidos" => query
                    .Where(e => e.IsHidden)
                    .OrderBy(e => e.LimitDate),

                _ => query.Where(e => !e.IsHidden)
            };
        }
    }

    // Calcula o Estado dinamicamente baseado nos dados reais
    private string GetStatusString(StudentDashboardCardDto e)
    {
        bool isCompleted = e.IsArchived || e.IsFullyEvaluated || (e.LimitDate.HasValue && e.LimitDate < DateTime.UtcNow);
        
        if (isCompleted)
        {
            var minScore = e.MinimumApprovalScore > 0 ? e.MinimumApprovalScore : 65;
            return e.ProgressPercentage >= minScore ? "Concluído (Aprovado)" : "Concluído (Reprovado)";
        }

        if (!e.StartDate.HasValue) return "Pendente";
        if (e.StartDate > DateTime.UtcNow) return "Por iniciar";

        return "Em curso";
    }

    // Mapeia o Estado para as classes do app.css
    private (string BadgeClass, string BarClass, string ColorVar, string Icon) GetStatusTheme(string status)
    {
        return status?.Trim().ToLower() switch
        {
            "concluído (aprovado)" => ("status-approved", "bg-bar-approved", "approved", "bi-check-circle-fill"),
            "concluído (reprovado)" => ("status-reproved", "bg-bar-reproved", "reproved", "bi-x-circle-fill"),
            "pendente" => ("status-pendente", "bg-bar-pendente", "pendente", "bi-exclamation-circle-fill"),
            "em curso" => ("status-em-curso", "bg-bar-em-curso", "brand", "bi-clock-history"),
            "por iniciar" => ("status-por-iniciar", "bg-bar-por-iniciar", "por-iniciar", "bi-circle"),
            _ => ("status-por-iniciar", "bg-bar-por-iniciar", "por-iniciar", "bi-info-circle")
        };
    }

    private async Task ToggleStar(StudentDashboardCardDto e)
    {
        e.IsStarred = !e.IsStarred;
        await Http.PutAsJsonAsync($"api/Enrollment/{e.EnrollmentId}/star", e.IsStarred);
    }

    private async Task ToggleHidden(StudentDashboardCardDto e)
    {
        e.IsHidden = !e.IsHidden;
        await Http.PutAsJsonAsync($"api/Enrollment/{e.EnrollmentId}/hidden", e.IsHidden);
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void SelectTab(string tab)
    {
        currentTab = tab;
        isDropdownOpen = false;
    }
}
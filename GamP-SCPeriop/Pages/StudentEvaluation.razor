@page "/evaluate/{EnrollmentId:int}"
@using GamP_SCPeriop.Shared.Data
@using GamP_SCPeriop.Shared.Entity.Model
@using GamP_SCPeriop.Shared.Enum
@layout TopNavBarLayout
@inject HttpClient Http
@inject NavigationManager Nav

<!-- MAIN CONTAINER -->
<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 px-3">

            <!-- TOP ACTION BAR: Navigation and Batch Save Controls -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <button class="btn btn-link text-decoration-none text-muted p-0 fw-semibold" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-2"></i> Voltar ao Dashboard
                </button>

                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <span class="text-success fw-bold me-3">@successMessage</span>
                    }
                    <button class="btn btn-primary" @onclick="SaveEvaluationsAsync" disabled="@(isSaving || !pendingEvaluations.Any())">
                        @(isSaving ? "A guardar..." : "Guardar Avaliações")
                    </button>
                </div>
            </div>

            <!-- VIEW STATE: Loading -->
            @if (isLoading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }            
            else if (enrollmentModules == null || !enrollmentModules.Any()) 
            {
                <!-- VIEW STATE: Error / Not Found -->
                <div class="alert alert-danger shadow-sm border-0" style="border-radius: 15px;">
                    Inscrição não encontrada.
                </div>
            }
            else 
            {
                <!-- VIEW STATE: Loaded successfully -->
                <!-- STUDENT PROFILE HEADER -->
                <div class="card shadow-sm border-0 mb-5" style="border-radius: 20px; background-color: #6A96A6; color: white;">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-white text-dark bg-opacity-25 px-3 py-2" style="border-radius: 10px;">Ficha de Avaliação</span>
                            <span class="fw-bold text-white fs-5">@firstEnrollment?.ProgressPercentage% Concluído</span>
                        </div>
                        <h3 class="fw-bold mb-1">@firstEnrollment?.Student?.DisplayShortName</h3>
                        <p class="mb-0 text-white-50">Percurso: @firstEnrollment?.Pathway?.Title</p>
                    </div>
                </div>

                <!-- MODULE ACCORDION LOOP -->
                @if (enrollmentModules != null)
                {
                    @foreach (var em in enrollmentModules.Where(x => x.Module != null))
                    {
                        var module = em.Module;
                        var practicalStages = GetValidPracticalStages(module);

                        @if (practicalStages.Any())
                        {
                            bool isExpanded = expandedModules.Contains(module.Id);

                            <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; border-left: 5px solid #2c3e50; overflow: hidden;">

                                <!-- MODULE HEADER: Clickable to expand/collapse -->
                                <div class="card-header bg-white border-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center"
                                     style="cursor: pointer;"
                                     @onclick="() => ToggleAccordion(module.Id)">
                                    <h4 class="fw-bold text-uppercase mb-0" style="color: #2c3e50; letter-spacing: 1px;">
                                        @module.Title
                                    </h4>
                                    <button class="btn btn-link text-muted p-0 shadow-none">
                                        <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") fs-5"></i>
                                    </button>
                                </div>

                                <!-- MODULE BODY: Active only when expanded -->
                                @if (isExpanded)
                                {
                                    <div class="card-body p-4 border-top">
                                        @{
                                            var currentStage = activeTabs.ContainsKey(module.Id) ? activeTabs[module.Id] : practicalStages.FirstOrDefault();
                                            var chronoStage = chronologicalTabs.ContainsKey(module.Id) ? chronologicalTabs[module.Id] : practicalStages.FirstOrDefault();
                                            var currentProgress = CalculateStageProgress(module, currentStage);
                                        }

                                        <!-- STAGE TABS: Navigation between evaluation phases -->
                                        <div class="d-flex w-100 mb-4 shadow-sm" style="height: 55px; border-radius: 12px; overflow: hidden; border: 1px solid rgba(0,0,0,0.1);">
                                            @foreach (var stage in practicalStages)
                                            {
                                                var isActive = currentStage == stage;
                                                var isChronological = chronoStage == stage;
                                                var isPastOrCurrent = (int)stage <= (int)chronoStage;

                                                string baseColor = isPastOrCurrent ? GetStageColor(stage) : "#e9ecef";
                                                string textColor = isPastOrCurrent ? "text-white" : "text-muted";
                                                string opacity = isActive ? "1" : (isPastOrCurrent ? "0.8" : "0.5");

                                                <button class="btn border-0 rounded-0 flex-grow-1 position-relative d-flex align-items-center justify-content-center p-0 shadow-none"
                                                        style="background-color: @baseColor; transition: all 0.3s ease; opacity: @opacity; border-right: 1px solid rgba(255,255,255,0.3);"
                                                        @onclick="() => activeTabs[module.Id] = stage" title="@FormatStageName(stage)">
                                                    <div class="d-flex align-items-center px-2 text-truncate @textColor" style="@(isPastOrCurrent ? "text-shadow: 1px 1px 2px rgba(0,0,0,0.4);" : "")">
                                                        <i class="bi @(isActive ? "bi-check-circle-fill" : "bi-calendar-week") me-2"></i>
                                                        <span class="@(isActive ? "fw-bold" : "fw-medium") text-truncate" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                                                            @FormatStageName(stage)
                                                        </span>
                                                    </div>

                                                    <!-- CHRONOLOGICAL INDICATOR: Highlights the current real-world week -->
                                                    @if (isChronological)
                                                    {
                                                        <span class="position-absolute top-0 start-50 translate-middle-x badge bg-dark bg-opacity-75 rounded-bottom shadow-sm"
                                                              style="font-size: 0.60rem; padding: 0.2rem 0.5rem; letter-spacing: 1px;">
                                                            SEMANA ATUAL
                                                        </span>
                                                    }
                                                </button>
                                            }
                                        </div>

                                        <!-- PROGRESS BAR: Visual representation of stage completion -->
                                        <div class="mb-4 px-2">
                                            <div class="d-flex justify-content-between align-items-end mb-2">
                                                <small class="text-muted fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                                                    <i class="bi bi-bar-chart-fill me-1"></i> Progresso: @FormatStageName(currentStage)
                                                </small>
                                                <small class="fw-bold fs-6" style="color: @GetTrafficLightColor(currentProgress);">@(currentProgress)%</small>
                                            </div>

                                            <div class="w-100 bg-light shadow-inner" style="height: 10px; border-radius: 10px; overflow: hidden; border: 1px solid #e9ecef;">
                                                <div class="h-100"
                                                     style="width: @(currentProgress)%;
                                                    background-color: @GetTrafficLightColor(currentProgress);
                                                    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.6s ease;
                                                    border-radius: 10px;">
                                                </div>
                                            </div>
                                        </div>

                                        <!-- TIMELINE VALIDATION: Checks if grading is blocked by date -->
                                        @{
                                            var activeTimeline = module.StageTimelines?.FirstOrDefault(t => t.Stage == currentStage);
                                            bool isStageBlocked = activeTimeline != null &&
                                                                  activeTimeline.StartDate.HasValue &&
                                                                  DateTime.Now.Date < activeTimeline.StartDate.Value.Date;
                                        }

                                        <!-- TIMELINE ALERTS: Displays block warning or end date -->
                                        @if (activeTimeline != null)
                                        {
                                            <div class="mb-5 px-1 d-flex justify-content-between align-items-center">
                                                @if (isStageBlocked)
                                                {
                                                    <span class="badge bg-warning text-dark border border-warning bg-opacity-25 px-3 py-2">
                                                        <i class="bi bi-lock-fill me-1"></i> Avaliação Bloqueada (Inicia a @(activeTimeline.StartDate.Value.ToString("dd/MM/yyyy")))
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span></span>
                                                }
                                                <small class="text-muted fw-bold">
                                                    <i class="bi bi-clock-history me-1"></i> Data Limite da Fase:
                                                    <span class="text-dark">
                                                        @(activeTimeline.EndDate.HasValue ? activeTimeline.EndDate.Value.ToString("dd/MM/yyyy") : "N/D")
                                                    </span>
                                                </small>
                                            </div>
                                        }

                                        <!-- TASKS GRID: Preparing parents and filtering assessable children -->
                                        @{
                                            var assessableComponents = module.Components.Where(c => c.Stage == currentStage).ToList();
                                            var topLevelItems = assessableComponents.Where(c => c.ParentComponentId == null).ToList();
                                        }

                                        @foreach (var item in topLevelItems)
                                        {
                                            // Fetch children but strictly filter out descriptive tasks (Weight == 0)
                                            var children = assessableComponents.Where(c => c.ParentComponentId == item.Id && c.Weight > 0).ToList();

                                            <!-- SCENARIO A: Parent Task WITH Assessable Children -->
                                            @if (children.Any())
                                            {
                                                <div class="mb-3 mt-4">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <div style="width: 5px; height: 22px; background-color: #6A96A6; border-radius: 4px;" class="me-3"></div>
                                                        <h5 class="fw-bold mb-0" style="color: #1c4c5e; @(isStageBlocked ? "opacity: 0.6;" : "")">@item.Title</h5>
                                                    </div>
                                                </div>

                                                <div class="d-flex flex-column gap-2 mb-4">
                                                    @foreach (var child in children)
                                                    {
                                                        <div class="card border-0 bg-light" style="border-radius: 10px; @(isStageBlocked ? "opacity: 0.6;" : "")">
                                                            <div class="card-body p-3 ms-4">
                                                                <div class="row align-items-center">
                                                                    <div class="col-md-5 mb-2 mb-md-0 d-flex align-items-center">
                                                                        <h6 class="fw-semibold mb-0 text-dark" style="font-size: 0.95rem;">@child.Title</h6>
                                                                    </div>
                                                                    <div class="col-md-7">
                                                                        <!-- Render grading inputs (Checkboxes or Buttons) -->
                                                                        @RenderAssessmentButtons(child, isStageBlocked)
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            <!-- SCENARIO B: Standalone Task (No children, and is NOT descriptive) -->
                                            else if (item.Weight > 0)
                                            {
                                                <div class="card border-0 bg-light mb-3" style="border-radius: 10px; @(isStageBlocked ? "opacity: 0.6;" : "")">
                                                    <div class="card-body p-3">
                                                        <div class="row align-items-center">
                                                            <div class="col-md-5 mb-2 mb-md-0 d-flex align-items-center">
                                                                <div style="width: 5px; height: 22px; background-color: #adb5bd; border-radius: 4px;" class="me-3"></div>
                                                                <h6 class="fw-bold mb-0 text-dark">@item.Title</h6>
                                                            </div>
                                                            <div class="col-md-7">
                                                                <!-- Render grading inputs (Checkboxes or Buttons) -->
                                                                @RenderAssessmentButtons(item, isStageBlocked)
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }

                                    </div>
                                }
                            </div>
                        }
                    }
                }
            }
        </div>
    </div>
</div>

@code {

    #region [ Parameters & Properties ]

    [Parameter] public int EnrollmentId { get; set; }

    private List<EnrollmentModule>? enrollmentModules;

    private Enrollment? firstEnrollment => enrollmentModules?.FirstOrDefault()?.Enrollment;

    #endregion

    #region [ UI State Variables ]

    private bool isLoading = true;
    private Dictionary<int, ModuleStage> activeTabs = new();
    private Dictionary<int, ModuleStage> chronologicalTabs = new();
    private HashSet<int> expandedModules = new();

    #endregion

    #region [ Batch Save State ]

    private Dictionary<int, EvaluationRequestDto> pendingEvaluations = new();
    private bool isSaving = false;
    private string successMessage = string.Empty;

    #endregion

    #region [ Lifecycle Methods ]

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    #endregion

    #region [ Data Loading & Initialization ]

    /// <summary>
    /// Fetches the enrollment modules from the API and initializes the UI tabs if data is found.
    /// </summary>
    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            enrollmentModules = await Http.GetFromJsonAsync<List<EnrollmentModule>>($"api/Evaluation/enrollment/{EnrollmentId}");

            if (enrollmentModules != null && enrollmentModules.Any())
            {
                InitializeTabs();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Sets up the active and chronological tabs for each module based on the current date and defined timelines.
    /// </summary>
    private void InitializeTabs()
    {
        if (enrollmentModules == null) return;

        foreach (var em in enrollmentModules)
        {
            var module = em.Module;
            if (module == null) continue;

            var practicalStages = GetValidPracticalStages(module);

            if (practicalStages.Any())
            {
                ModuleStage actualStage = practicalStages.First();

                if (module.StageTimelines != null && module.StageTimelines.Any())
                {
                    var today = DateTime.Now.Date;

                    var currentTimeline = module.StageTimelines
                        .FirstOrDefault(t => t.StartDate.HasValue && t.EndDate.HasValue &&
                                             today >= t.StartDate.Value.Date &&
                                             today <= t.EndDate.Value.Date);

                    if (currentTimeline != null)
                    {
                        actualStage = currentTimeline.Stage;
                    }
                    else
                    {
                        var lastTimeline = module.StageTimelines
                            .Where(t => t.EndDate.HasValue)
                            .OrderBy(t => t.EndDate.Value)
                            .LastOrDefault();

                        if (lastTimeline != null && today > lastTimeline.EndDate.Value.Date)
                        {
                            actualStage = lastTimeline.Stage;
                        }
                    }
                }

                activeTabs[module.Id] = actualStage;
                chronologicalTabs[module.Id] = actualStage;
            }

            var firstValidModule = enrollmentModules
                .Select(e => e.Module)
                .FirstOrDefault(m => m != null && GetValidPracticalStages(m).Any());

            if (firstValidModule != null)
            {
                expandedModules.Add(firstValidModule.Id);
            }
        }
    }

    #endregion

    #region [ UI Helpers & Formatting ]

    /// <summary>
    /// Formats the enum stage name into a readable string with spaces.
    /// </summary>
    private string FormatStageName(ModuleStage stage)
    {
        return System.Text.RegularExpressions.Regex.Replace(stage.ToString(), "([A-Z])", " $1").Trim();
    }

    /// <summary>
    /// Returns the specific hex color code associated with a given module stage.
    /// </summary>
    private string GetStageColor(ModuleStage stage)
    {
        return stage switch
        {
            ModuleStage.ObservacaoPassiva => "#6A96A6",
            ModuleStage.ObservacaoParticipada => "#F4A261",
            ModuleStage.PraticaAssistida => "#E76F51",
            ModuleStage.PraticaSupervisionada => "#2A9D8F",
            _ => "#6c757d"
        };
    }

    /// <summary>
    /// Returns a traffic light color code (red, yellow, green) based on the current progress percentage.
    /// </summary>
    private string GetTrafficLightColor(int progress)
    {
        if (progress <= 49) return "#dc3545";
        if (progress <= 79) return "#ffc107";
        if (progress < 100) return "#20c997";
        return "#198754";
    }

    /// <summary>
    /// Toggles the expanded or collapsed state of a specific module panel.
    /// </summary>
    private void ToggleAccordion(int moduleId)
    {
        if (expandedModules.Contains(moduleId))
            expandedModules.Remove(moduleId);
        else
            expandedModules.Add(moduleId);
    }

    #endregion

    #region [ Progress Calculation ]

    /// <summary>
    /// Calculates the completion percentage of assessable tasks for a specific module and stage.
    /// </summary>
    private int CalculateStageProgress(Module module, ModuleStage stage)
    {
        if (module.Components == null) return 0;

        var parentIds = module.Components
            .Where(c => c.ParentComponentId.HasValue)
            .Select(c => c.ParentComponentId.Value)
            .ToHashSet();

        var assessableComponents = module.Components
            .Where(c => c.Stage == stage)
            .Where(c => !parentIds.Contains(c.Id))
            .Where(c => c.Weight > 0)
            .ToList();

        if (!assessableComponents.Any()) return 0;

        int completed = assessableComponents.Count(c => IsTaskCompleted(c));
        return (int)Math.Clamp(((double)completed / assessableComponents.Count) * 100, 0, 100);
    }

    /// <summary>
    /// Recalculates the global progress percentage for the entire enrollment based on completed supervised/assisted tasks.
    /// </summary>
    private void RecalculateProgress()
    {
        if (enrollmentModules == null) return;

        int totalComponents = 0;
        int completedComponents = 0;

        foreach (var em in enrollmentModules)
        {
            var module = em.Module;

            if (module?.Components != null)
            {
                var parentIds = module.Components
                    .Where(c => c.ParentComponentId.HasValue)
                    .Select(c => c.ParentComponentId.Value)
                    .ToHashSet();

                var assessableComponents = module.Components
                    .Where(c => c.Stage == ModuleStage.PraticaSupervisionada || c.Stage == ModuleStage.PraticaAssistida)
                    .Where(c => !parentIds.Contains(c.Id))
                    .Where(c => c.Weight > 0)
                    .Where(c => module.StageTimelines != null && module.StageTimelines.Any(t => t.Stage == c.Stage && (t.StartDate.HasValue || t.EndDate.HasValue)))
                    .ToList();

                totalComponents += assessableComponents.Count;

                completedComponents += assessableComponents.Count(c =>
                                    c.Status == ComponentStatus.AcimaDaMedia ||
                                    c.Status == ComponentStatus.Consistente);
            }
        }

        if (firstEnrollment != null)
        {
            firstEnrollment.ProgressPercentage = totalComponents > 0
                ? (int)((double)completedComponents / totalComponents * 100)
                : 0;
        }
    }

    /// <summary>
    /// Extracts and orders a distinct list of valid practical stages that have active timelines for a given module.
    /// </summary>
    private List<ModuleStage> GetValidPracticalStages(Module module)
    {
        if (module?.Components == null) return new List<ModuleStage>();

        return module.Components
            .Where(c => c.Stage != ModuleStage.Teorica)
            .Select(c => c.Stage)
            .Distinct()
            .Where(s => module.StageTimelines != null && module.StageTimelines.Any(t => t.Stage == s && (t.StartDate.HasValue || t.EndDate.HasValue)))
            .OrderBy(s => (int)s)
            .ToList();
    }

    /// <summary>
    /// Checks if a component's status qualifies as completed (Consistent or Above Average).
    /// </summary>
    private bool IsTaskCompleted(ModuleComponent comp)
    {
        return comp.Status == ComponentStatus.Consistente || comp.Status == ComponentStatus.AcimaDaMedia;
    }

    #endregion

    #region [ Evaluation & Saving ]

    /// <summary>
    /// Updates the local component status and queues the change in the pending evaluations dictionary for batch saving.
    /// </summary>
    private void QueueEvaluation(ModuleComponent component, ComponentStatus newStatus)
    {
        successMessage = string.Empty;

        // Update local object to reflect the change visually right away
        component.Status = newStatus;
        RecalculateProgress();

        // Add to batch dictionary
        if (pendingEvaluations.ContainsKey(component.Id))
        {
            pendingEvaluations[component.Id].Status = newStatus;
        }
        else
        {
            pendingEvaluations[component.Id] = new EvaluationRequestDto
            {
                EnrollmentId = this.EnrollmentId,
                ModuleComponentId = component.Id,
                Status = newStatus
            };
        }
    }

    /// <summary>
    /// Sends all pending evaluation changes to the backend API in a single batch request.
    /// </summary>
    private async Task SaveEvaluationsAsync()
    {
        if (!pendingEvaluations.Any()) return;

        isSaving = true;
        successMessage = string.Empty;

        var payload = pendingEvaluations.Values.ToList();

        var response = await Http.PostAsJsonAsync("api/Evaluation", payload);

        if (response.IsSuccessStatusCode)
        {
            pendingEvaluations.Clear();
            successMessage = "Avaliações guardadas com sucesso!";
        }
        else
        {
            successMessage = "Erro ao guardar avaliações.";
        }

        isSaving = false;
    }

    /// <summary>
    /// Handles the checkbox toggle for passive/participatory observation stages, queuing the corresponding status.
    /// </summary>
    private void ToggleChecklist(ModuleComponent comp, object? isChecked)
    {
        bool isCompleted = (bool)(isChecked ?? false);
        var newStatus = isCompleted ? ComponentStatus.Consistente : (ComponentStatus)0;

        QueueEvaluation(comp, newStatus);
    }

    /// <summary>
    /// Dynamically generates the appropriate input controls (checkboxes or grading buttons) based on the stage and timeline block status.
    /// </summary>
    private RenderFragment RenderAssessmentButtons(ModuleComponent comp, bool isBlocked) => __builder =>
    {
        @if (comp.Stage == ModuleStage.ObservacaoPassiva || comp.Stage == ModuleStage.ObservacaoParticipada)
        {
            <div class="d-flex justify-content-end">
                <input class="form-check-input" type="checkbox"
                       style="width: 1.5rem; height: 1.5rem; cursor: @(isBlocked ? "not-allowed" : "pointer"); border: 2px solid #8c98a4;"
                       checked="@IsTaskCompleted(comp)"
                       disabled="@isBlocked"
                       @onchange="(e) => ToggleChecklist(comp, e.Value)" />
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm flex-grow-1 @(comp.Status == ComponentStatus.Inconsistente ? "btn-danger" : "btn-outline-danger")"
                        disabled="@isBlocked"
                        @onclick="() => QueueEvaluation(comp, ComponentStatus.Inconsistente)">
                    Inconsistente
                </button>

                <button class="btn btn-sm flex-grow-1 @(comp.Status == ComponentStatus.AbaixoDaMedia ? "btn-warning text-dark" : "btn-outline-warning text-dark")"
                        disabled="@isBlocked"
                        @onclick="() => QueueEvaluation(comp, ComponentStatus.AbaixoDaMedia)">
                    Abaixo da Média
                </button>

                <button class="btn btn-sm flex-grow-1 @(comp.Status == ComponentStatus.AcimaDaMedia ? "btn-warning bg-opacity-50 text-dark border-warning" : "btn-outline-secondary")"
                        style="@(comp.Status == ComponentStatus.AcimaDaMedia ? "background-color: #ffda6a;" : "")"
                        disabled="@isBlocked"
                        @onclick="() => QueueEvaluation(comp, ComponentStatus.AcimaDaMedia)">
                    Acima da Média
                </button>

                <button class="btn btn-sm flex-grow-1 @(comp.Status == ComponentStatus.Consistente ? "btn-success shadow-sm fw-bold" : "btn-outline-success opacity-75")"
                        disabled="@isBlocked"
                        @onclick="() => QueueEvaluation(comp, ComponentStatus.Consistente)">
                    @if (comp.Status == ComponentStatus.Consistente)
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                    }
                    Consistente
                </button>
            </div>
        }
    };

    #endregion

    #region [ Navigation ]

    /// <summary>
    /// Navigates the user back to the pathway's student list or the main dashboard.
    /// </summary>
    private void GoBack()
    {
        if (firstEnrollment != null && firstEnrollment.PathwayId > 0)
        {
            Nav.NavigateTo($"/pathway/{firstEnrollment.PathwayId}/students");
        }
        else
        {
            Nav.NavigateTo("/dashboard");
        }
    }

    #endregion

}
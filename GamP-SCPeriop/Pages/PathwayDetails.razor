@page "/pathway/{Id:int}"
@attribute [Authorize(Roles = "Supervisionado")]
@using GamP_SCPeriop.Shared.Enum
@using GamP_SCPeriop.Shared.Data
@layout TopNavBarLayout
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10 mt-3 px-2">

            <!-- BOTAO VOLTAR -->
            <button class="btn btn-link text-decoration-none px-0 mb-4 text-secondary fw-semibold d-flex align-items-center"
                    @onclick='() => Nav.NavigateTo("/my-profile")'>
                <i class="bi bi-arrow-left me-2 fs-5"></i> Voltar ao Dashboard
            </button>

            @if (enrollment == null)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else
            {
                <!-- CABEÇALHO DO PERCURSO -->
                <div class="mb-4">
                    <h3 class="fw-bold mb-2" style="color: #2c3e50;">@enrollment.Pathway?.Title</h3>
                    <p class="text-muted">
                        <i class="bi bi-person-badge me-2"></i>Supervisor: @(enrollment.Professor?.DisplayShortName ?? "Atribuído")
                    </p>
                </div>

                <!-- LISTA DE MÓDULOS (Design das setas) -->
                <div class="card border-0 shadow-sm mb-5" style="border-radius: 16px; overflow: hidden;">

                    @if (enrollment.Pathway?.Modules == null || !enrollment.Pathway.Modules.Any())
                    {
                        <div class="p-4 text-center text-muted">Este percurso ainda não tem módulos disponíveis.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var module in enrollment.Pathway.Modules)
                            {
                                var modProgress = CalculateModuleProgress(module);
                                var minScore = enrollment.Pathway.MinimumApprovalScore > 0 ? enrollment.Pathway.MinimumApprovalScore : 100;

                                <button class="list-group-item list-group-item-action p-4 d-flex justify-content-between align-items-center"
                                        style="border-bottom: 1px solid #f0f0f0; cursor: pointer; transition: background-color 0.2s;"
                                        @onclick='() => Nav.NavigateTo($"/module/{module.Id}")'>

                                    <!-- Esquerda: Informação do Módulo -->
                                    <div class="d-flex align-items-center me-3">
                                        <div class="rounded-circle d-flex justify-content-center align-items-center me-4 shadow-sm"
                                             style="width: 45px; height: 45px; background-color: #E2ECEF; color: #6A96A6;">
                                            <i class="bi bi-journal-text fs-5"></i>
                                        </div>

                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">@module.Title</h5>

                                            <div class="d-flex align-items-center gap-2 mt-2">
                                                @if (modProgress >= minScore)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1">
                                                        <i class="bi bi-check2-circle me-1"></i> Aprovado
                                                    </span>
                                                }
                                                else if (module.Status == "Em curso" || modProgress > 0)
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2 py-1">
                                                        Em Curso (@(modProgress)%)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1">
                                                        Pendente
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Direita: A Seta Clássica -->
                                    <i class="bi bi-chevron-right text-secondary fs-4"></i>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; } // Recebe o PathwayId do URL

    [CascadingParameter]
    public User? currentUser { get; set; }

    private Enrollment? enrollment;

    protected override async Task OnInitializedAsync()
    {
        if (currentUser == null) return;

        try
        {
            // Reaproveitamos a API que já tens para carregar tudo
            var allEnrollments = await Http.GetFromJsonAsync<List<Enrollment>>($"api/Enrollment/student/{currentUser.Id}");

            // Filtramos apenas a inscrição que pertence a este Pathway específico
            enrollment = allEnrollments?.FirstOrDefault(e => e.PathwayId == Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar o percurso: {ex.Message}");
        }
    }

    // A mesma lógica matemática que já usavas no Dashboard
    private int CalculateModuleProgress(Module mod)
    {
        if (mod.Components == null) return 0;

        var assessable = mod.Components
                    .Where(c => c.Stage == ModuleStage.PraticaSupervisionada)
                    .Where(c => !mod.Components.Any(child => child.ParentComponentId == c.Id))
                    .ToList();

        if (!assessable.Any()) return 0;

        int completed = assessable.Count(c => c.Status == ComponentStatus.AcimaDaMedia || c.Status == ComponentStatus.Consistente);
        return (int)((double)completed / assessable.Count * 100);
    }
}
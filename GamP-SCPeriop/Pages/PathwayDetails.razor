@page "/pathway/{Id:int}"
@attribute [Authorize(Roles = "Supervisionado")]
@using GamP_SCPeriop.Shared.Enum
@using GamP_SCPeriop.Shared.Data
@using GamP_SCPeriop.Helpers
@layout TopNavBarLayout
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10 mt-3 px-2">

            <!-- BOTAO VOLTAR -->
            <button class="btn btn-link text-decoration-none px-0 mb-4 text-secondary fw-semibold d-flex align-items-center"
                    @onclick='() => Nav.NavigateTo("/my-profile")'>
                <i class="bi bi-arrow-left me-2 fs-5"></i> Voltar ao Dashboard
            </button>

            @if (pathwayModules == null)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (!pathwayModules.Any())
            {
                <div class="p-4 text-center text-muted">Este percurso ainda não tem módulos disponíveis.</div>
            }
            else
            {
                var firstLine = pathwayModules.First();
                var pathway = firstLine.Enrollment?.Pathway;
    
                // Calcula o fecho usando o novo método que varre todas as datas
                var maxLimit = pathwayModules.Max(m => ModuleDateHelper.GetActualEndDate(m.Module));
                bool isParentClosed = (pathway?.IsArchived ?? false) || (maxLimit.HasValue && maxLimit.Value < DateTime.UtcNow);

                <!-- O teu cabeçalho mantém-se igual aqui -->

                <div class="card border-0 shadow-sm mb-5" style="border-radius: 16px; overflow: hidden;">
                    <div class="list-group list-group-flush">
                        @foreach (var m in pathwayModules)
                        {
                            var module = m.Module;
                            if (module == null) continue;

                            var modProgress = CalculateModuleProgress(module);
                            var minScore = pathway?.MinimumApprovalScore > 0 ? pathway.MinimumApprovalScore : 100;

                            // Extrai as datas reais deste módulo
                            var actualStart = ModuleDateHelper.GetActualStartDate(m.Module);
                            var actualEnd = ModuleDateHelper.GetActualEndDate(m.Module);

                            <button class="list-group-item list-group-item-action p-4 d-flex justify-content-between align-items-center"
                                    style="border-bottom: 1px solid #f0f0f0; cursor: pointer; transition: background-color 0.2s;"
                                    @onclick='() => Nav.NavigateTo($"/module/{module.Id}")'>

                                <div class="d-flex align-items-center me-3">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center me-4 shadow-sm bg-secondary bg-opacity-10 text-secondary"
                                         style="width: 45px; height: 45px;">
                                        <i class="bi bi-journal-text fs-5"></i>
                                    </div>

                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">@module.Title</h5>
                            
                                        <!-- Nova Linha de Datas usando as variáveis calculadas -->
                                        <div class="text-muted mb-2" style="font-size: 0.85rem;">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            @(actualStart.HasValue ? actualStart.Value.ToString("dd MMM yyyy") : "A definir") 
                                            <i class="bi bi-arrow-right mx-1 text-secondary opacity-50"></i> 
                                            @(actualEnd.HasValue ? actualEnd.Value.ToString("dd MMM yyyy") : "A definir")
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            @{ var badge = GetModuleBadge(modProgress, minScore, isParentClosed, actualStart, actualEnd); }
                                            <span class="badge @badge.CssClass rounded-pill px-2 py-1">
                                                <i class="bi @badge.Icon me-1"></i> @badge.Text
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-secondary fs-4"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; } // Recebe o PathwayId do URL

    [CascadingParameter]
    public User? currentUser { get; set; }

    private List<EnrollmentModule>? pathwayModules;

    protected override async Task OnInitializedAsync()
    {
        if (currentUser == null) return;

        try
        {
            // Reaproveitamos a API que já tens para carregar tudo
            pathwayModules = await Http.GetFromJsonAsync<List<EnrollmentModule>>($"api/Enrollment/student/{currentUser.Id}/pathway/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar o percurso: {ex.Message}");
        }
    }

    // A mesma lógica matemática que já usavas no Dashboard
    private int CalculateModuleProgress(Module mod)
    {
        if (mod.Components == null) return 0;

        // AQUI: Aplicamos a tua regra das duas fases
        var assessable = mod.Components
                    .Where(c => c.Stage == ModuleStage.PraticaSupervisionada || c.Stage == ModuleStage.PraticaAssistida)
                    .Where(c => !mod.Components.Any(child => child.ParentComponentId == c.Id))
                    .ToList();

        if (!assessable.Any()) return 0;

        int completed = assessable.Count(c => c.Status == ComponentStatus.AcimaDaMedia || c.Status == ComponentStatus.Consistente);
        return (int)((double)completed / assessable.Count * 100);
    }

    private (string Text, string CssClass, string Icon) GetModuleBadge(int progress, int minScore, bool isParentClosed, DateTime? actualStart, DateTime? actualEnd)
    {
        // 1. Aprovado
        if (progress >= minScore)
            return ("Aprovado", "bg-transparent bg-opacity-10 text-success border border-success border-opacity-25", "bi-check2-circle");

        var now = DateTime.UtcNow;
        bool isModuleExpired = actualEnd.HasValue && actualEnd.Value < now;

        // 2. Reprovado (O prazo deste módulo expirou OU o percurso pai fechou)
        if (isParentClosed || isModuleExpired)
            return ("Reprovado", "bg-transparent bg-opacity-10 text-danger border border-danger border-opacity-25", "bi-x-circle");

        // 3. Em Curso (Já começou e está dentro do prazo)
        if (actualStart.HasValue && actualStart.Value <= now)
            return ($"Em Curso ({progress}%)", "bg-transparent text-primary border border-primary border-opacity-50", "bi-play-circle");

        // 4. Por Agendar (O professor ainda não definiu a data de início)
        if (!actualStart.HasValue)
            return ("Por Agendar", "bg-outline-info text-secondary border border-secondary border-opacity-25", "bi-calendar-minus");

        // 5. Pendente (Já tem datas, mas o dia de início ainda está no futuro)
        return ("Pendente", "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25", "bi-hourglass-split");
    }
}
@page "/module/{ModuleId:int}"
@using GamP_SCPeriop.Shared.Data
@using GamP_SCPeriop.Shared.Enum
@using static GamP_SCPeriop.Helpers.UIHelpers
@layout TopNavBarLayout
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10 px-2">

            <!-- BOTAO VOLTAR INTELIGENTE -->
            <div class="mb-4">
                <button class="btn btn-link text-secondary fw-semibold p-0 text-decoration-none d-flex align-items-center" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-2 fs-5"></i> Voltar ao Percurso
                </button>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (module == null)
            {
                <div class="alert alert-danger shadow-sm border-0" style="border-radius: 15px;">
                    Módulo não encontrado ou sem permissão para visualizar.
                </div>
            }
            else
            {
                <!-- CABEÇALHO DO MÓDULO -->
                <div class="card detail-header-card shadow-sm mb-5">
                    <div class="p-4 pb-3 bg-white">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <h4 class="fw-bold mb-0" style="color: #2c3e50;">@module.Title</h4>
                            <div class="d-flex align-items-center gap-2" style="min-width: 200px;">
                                <small class="text-muted fw-semibold">@(moduleProgress == 100 ? "Concluído" : "Em Curso")</small>
                                <div class="bg-light flex-grow-1 shadow-inner" style="height: 10px; border-radius: 10px; overflow: hidden;">
                                    <div class="h-100" style="width: @(moduleProgress)%; background-color: @(moduleProgress == 100 ? "#198754" : "#6A96A6"); transition: width 0.5s ease-in-out;"></div>
                                </div>
                                <small class="text-muted fw-bold">@(moduleProgress)%</small>
                            </div>
                        </div>
                    </div>

                    <div class="detail-header-bottom border-top px-4 py-3 bg-light" style="border-radius: 0 0 10px 10px;">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@parentPathway?.Title</h6>
                                <small class="text-muted">Módulo do Percurso</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-secondary fw-semibold small">Progresso Global</small>
                                <div class="bg-white border shadow-sm" style="width: 60px; height: 8px; border-radius: 10px; overflow: hidden;">
                                    <div class="h-100" style="width: @(globalProgress)%; background-color: #2c3e50; transition: width 0.5s ease-in-out;"></div>
                                </div>
                                <small class="text-muted fw-bold small">@(globalProgress)%</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LISTA MESTRA DE FASES -->
                <div class="mb-5">
                    @{
                        var componentsByStage = module.Components
                            ?.GroupBy(c => c.Stage)
                            .OrderBy(g => (int)g.Key)
                            .ToList();
                    }

                    @if (componentsByStage != null && componentsByStage.Any())
                    {
                        @foreach (var stageGroup in componentsByStage)
                        {
                            var currentStage = stageGroup.Key;
                            var isStageOpen = expandedStages.Contains(currentStage);
                            bool isCheckboxStage = currentStage == ModuleStage.ObservacaoPassiva || currentStage == ModuleStage.ObservacaoParticipada;

                            string stageTitle = currentStage switch
                            {
                                ModuleStage.Teorica => "Material de Estudo",
                                ModuleStage.ObservacaoPassiva => "Fase de Observação Passiva",
                                ModuleStage.ObservacaoParticipada => "Fase de Observação Participada",
                                ModuleStage.PraticaAssistida => "Fase de Prática Assistida",
                                ModuleStage.PraticaSupervisionada => "Avaliação Final (Prática Supervisionada)",
                                _ => currentStage.ToString()
                            };

                            string stageIcon = currentStage == ModuleStage.Teorica ? "bi-journal-bookmark" : "bi-award";
                            string stageColor = currentStage == ModuleStage.Teorica ? "#6A96A6" : "#2c3e50";

                            <div class="d-flex justify-content-between align-items-center mb-3 mt-4 p-3 bg-white shadow-sm"
                                 style="cursor: pointer; border-radius: 12px; transition: background-color 0.2s;"
                                 @onclick="() => ToggleStage(currentStage)">

                                <h5 class="fw-bold mb-0" style="color: #2c3e50;">
                                    <i class="bi @stageIcon me-2" style="color: @stageColor;"></i>@stageTitle
                                </h5>

                                <i class="bi @(isStageOpen ? "bi-chevron-up" : "bi-chevron-down") text-secondary fs-5"></i>
                            </div>

                            @if (isStageOpen)
                            {
                                if (currentStage == ModuleStage.Teorica)
                                {
                                    <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; border-left: 5px solid @stageColor;">
                                        <div class="card-body p-4">
                                            <div class="d-flex flex-column gap-3">
                                                @foreach (var comp in stageGroup)
                                                {
                                                    var isMatOpen = expandedMaterials.Contains(comp.Id);
                                                    <div class="card border border-light" style="border-radius: 10px; background-color: #f8f9fa;">

                                                        <div class="card-header bg-transparent border-0 p-3 d-flex justify-content-between align-items-center"
                                                             style="cursor: pointer;" @onclick="() => ToggleMaterial(comp.Id)">
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-file-earmark-text text-info me-3 fs-5"></i>
                                                                <span class="fw-bold text-dark text-wrap">@comp.Title</span>
                                                            </div>
                                                            <i class="bi @(isMatOpen ? "bi-chevron-up" : "bi-chevron-down") text-muted fs-5"></i>
                                                        </div>

                                                        @if (isMatOpen)
                                                        {
                                                            <div class="card-body border-top p-4 bg-white" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                                                                @if (!string.IsNullOrWhiteSpace(comp.Description))
                                                                {
                                                                    <p class="text-secondary mb-3" style="white-space: pre-line; font-size: 0.95rem;">@comp.Description</p>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(comp.PdfFilePath))
                                                                {
                                                                    <a href="@comp.PdfFilePath" target="_blank" class="btn btn-sm text-white fw-semibold bg-primary border-0 px-4 py-2" style="border-radius: 8px;">
                                                                        <i class="bi bi-file-earmark-pdf me-2 fs-6 align-middle"></i>Abrir Documento
                                                                    </a>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; border-left: 5px solid @stageColor;">
                                        <div class="card-body p-4">
                                            @{
                                                var assessableComponents = stageGroup.ToList();
                                                var topLevelItems = assessableComponents.Where(c => c.ParentComponentId == null).ToList();
                                            }

                                            @if (topLevelItems.Any())
                                            {
                                                @foreach (var item in topLevelItems)
                                                {
                                                    var children = assessableComponents.Where(c => c.ParentComponentId == item.Id).ToList();
                                                    bool isItemCompleted = IsCompleted(item.Status);

                                                    @if (children.Any())
                                                    {
                                                        <div class="mb-3 mt-4">
                                                            <div class="d-flex align-items-center mb-2">
                                                                <div style="width: 5px; height: 22px; background-color: #6A96A6; border-radius: 4px;" class="me-3 flex-shrink-0"></div>
                                                                <h5 class="fw-bold mb-0 text-wrap" style="color: #1c4c5e;">@item.Title</h5>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex flex-column gap-2 mb-4">
                                                            @foreach (var child in children)
                                                            {
                                                                bool isChildCompleted = IsCompleted(child.Status);

                                                                <div class="card border-0 @(isCheckboxStage && isChildCompleted ? "bg-success bg-opacity-10" : "bg-light")" style="border-radius: 10px; transition: background-color 0.3s;">
                                                                    <div class="card-body p-3 ms-4">
                                                                        <div class="row align-items-center">
                                                                            <div class="col-md-9 mb-2 mb-md-0 d-flex align-items-center">
                                                                                <h6 class="fw-semibold mb-0 @(isCheckboxStage && isChildCompleted ? "text-success" : "text-dark") text-wrap" style="font-size: 0.95rem;">@child.Title</h6>
                                                                            </div>
                                                                            <div class="col-md-3 text-md-end">
                                                                                @if (!isCheckboxStage)
                                                                                {
                                                                                    <span class="badge rounded-pill @GetBadgeCss(child.Status) px-3 py-2 border shadow-sm" style="font-size: 0.75rem;">@GetBadgeText(child.Status)</span>
                                                                                }
                                                                                else if (isChildCompleted)
                                                                                {
                                                                                    <i class="bi bi-check-lg text-success fs-4"></i>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="card border-0 @(isCheckboxStage && isItemCompleted ? "bg-success bg-opacity-10" : "bg-light") mb-3" style="border-radius: 10px; transition: background-color 0.3s;">
                                                            <div class="card-body p-3">
                                                                <div class="row align-items-center">
                                                                    <div class="col-md-9 mb-2 mb-md-0 d-flex align-items-center">
                                                                        <div style="width: 5px; height: 22px; background-color: @(isCheckboxStage && isItemCompleted ? "#198754" : "#adb5bd"); border-radius: 4px;" class="me-3 flex-shrink-0"></div>
                                                                        <h6 class="fw-bold mb-0 @(isCheckboxStage && isItemCompleted ? "text-success" : "text-dark") text-wrap">@item.Title</h6>
                                                                    </div>
                                                                    <div class="col-md-3 text-md-end">
                                                                        @if (!isCheckboxStage)
                                                                        {
                                                                            <span class="badge rounded-pill @GetBadgeCss(item.Status) px-3 py-2 border shadow-sm" style="font-size: 0.75rem;">@GetBadgeText(item.Status)</span>
                                                                        }
                                                                        else if (isItemCompleted)
                                                                        {
                                                                            <i class="bi bi-check-lg text-success fs-4"></i>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <div class="alert alert-light text-center border mb-0 text-muted" style="border-radius: 8px;">
                                                    <i class="bi bi-info-circle me-2"></i> Ainda não existem parâmetros definidos para esta fase.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public User? currentUser { get; set; }

    [Parameter] public int ModuleId { get; set; }

    private Module? module;
    private Pathway? parentPathway;
    private bool isLoading = true;

    private HashSet<int> expandedMaterials = new HashSet<int>();
    private HashSet<ModuleStage> expandedStages = new HashSet<ModuleStage> { ModuleStage.Teorica, ModuleStage.PraticaSupervisionada };

    private int moduleProgress = 0;
    private int globalProgress = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            if (currentUser != null)
            {
                module = await Http.GetFromJsonAsync<Module>($"api/Module/{ModuleId}/student/{currentUser.Id}");

                if (module != null && module.PathwayId > 0)
                {
                    moduleProgress = CalculateModuleProgress(module);

                    var enrollments = await Http.GetFromJsonAsync<List<Enrollment>>($"api/Enrollment/student/{currentUser.Id}");
                    var enrollment = enrollments?.FirstOrDefault(e => e.PathwayId == module.PathwayId);

                    if (enrollment != null)
                    {
                        parentPathway = enrollment.Pathway;
                        globalProgress = CalculateGlobalProgress(enrollment);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading module: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleMaterial(int compId)
    {
        if (expandedMaterials.Contains(compId)) expandedMaterials.Remove(compId);
        else expandedMaterials.Add(compId);
    }

    private void ToggleStage(ModuleStage stage)
    {
        if (expandedStages.Contains(stage))
            expandedStages.Remove(stage);
        else
            expandedStages.Add(stage);
    }

    private bool IsCompleted(ComponentStatus status)
    {
        return status == ComponentStatus.Consistente || status == ComponentStatus.AcimaDaMedia;
    }

    private void GoBack()
    {
        if (module != null && module.PathwayId > 0)
        {
            Nav.NavigateTo($"/pathway/{module.PathwayId}");
        }
        else
        {
            Nav.NavigateTo("/my-profile");
        }
    }

    private int CalculateModuleProgress(Module mod)
    {
        if (mod.Components == null) return 0;

        // Adicionada a Prática Assistida ao filtro, tal como combinámos
        var assessable = mod.Components
                    .Where(c => c.Stage == ModuleStage.PraticaSupervisionada || c.Stage == ModuleStage.PraticaAssistida)
                    .Where(c => !mod.Components.Any(child => child.ParentComponentId == c.Id))
                    .ToList();

        if (!assessable.Any()) return 0;

        int completed = assessable.Count(c => c.Status == ComponentStatus.AcimaDaMedia || c.Status == ComponentStatus.Consistente);
        return (int)((double)completed / assessable.Count * 100);
    }

    private int CalculateGlobalProgress(Enrollment enrollment)
    {
        return enrollment?.ProgressPercentage ?? 0;
    }
}
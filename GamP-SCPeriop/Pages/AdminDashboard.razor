@page "/admin/dashboard"
@attribute [Authorize(Roles = "Support")]
@layout TopNavBarLayout
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="mb-5">
        <h2 class="fw-bold mb-0">Painel de Suporte</h2>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        <!-- Cartão: Pathway Templates -->
        <div class="col">
            <div class="card border-0 h-100 admin-module-card" style="background-color: var(--card-bg)" @onclick='@(() => Nav.NavigateTo("/templates"))'>
                <div class="card-body p-4 d-flex flex-column">

                    <!-- Ícone ilustrativo -->
                    <div class="mb-4 text-primary">
                        <i class="bi bi-collection-play" style="font-size: 2.5rem;"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2" style="line-height: 1.2;">
                        Pathway Templates
                    </h4>

                    <p class="text-secondary small mt-auto mb-0">
                        Cria e gere os moldes dos percursos de aprendizagem e o seu sistema de Badges.
                    </p>

                </div>
            </div>
        </div>

        <!-- Cartão: Gestão de Utilizadores -->
        <div class="col">
            <div class="card border-0 h-100 admin-module-card" style="background-color: var(--card-bg)" @onclick='@(() => Nav.NavigateTo("/admin/users"))'>
                <div class="card-body p-4 d-flex flex-column">
                    <!-- Ícone ilustrativo (verde para contrastar com o primary) -->
                    <div class="mb-4 text-success">
                        <i class="bi bi-people-fill" style="font-size: 2.5rem;"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2" style="line-height: 1.2;">
                        Gestão de Utilizadores
                    </h4>

                    <p class="text-secondary small mt-auto mb-0">
                        Cria contas de Professores, Supervisores e Estudantes e gere os acessos ao sistema.
                    </p>
                </div>
            </div>
        </div>

        <!-- Cartão: Percursos (todos os professores) -->
        <div class="col">
            <div class="card border-0 h-100 admin-module-card" style="background-color: var(--card-bg)" @onclick='@(() => Nav.NavigateTo("/dashboard"))'>
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-4 text-warning">
                        <i class="bi bi-diagram-3-fill" style="font-size: 2.5rem;"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2" style="line-height: 1.2;">
                        Percursos e Estudantes
                    </h4>

                    <p class="text-secondary small mt-auto mb-0">
                        Vê e corrige os percursos de todos os professores, os estudantes e os supervisores atribuídos.
                    </p>
                </div>
            </div>
        </div>

        <!-- Espaço para futuros módulos (Ex: Gestão de Utilizadores, Configurações Globais) -->
        <!--
        <div class="col">
            <div class="card border-0 h-100 admin-module-card" @onclick="NavigateToUsers">
                ...
            </div>
        </div>
        -->

    </div>
</div>

@code {
    private string GenerateRandomPassword()
    {
        var chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890!@#$%^&*";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, 10)
            .Select(s => s[random.Next(s.Length)]).ToArray());
    }
}
@if (isAddModuleModalOpen)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.6); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 15px; background-color: #f4f7f6;">

                <div class="modal-header border-bottom-0 pb-2 pt-4 px-4 bg-white" style="border-radius: 15px 15px 0 0;">
                    <h4 class="modal-title fw-bold text-primary"><i class="bi bi-folder-plus me-2"></i>Criar Novo Módulo</h4>
                    <button type="button" class="btn-close" @onclick="CloseAddModuleModal"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <div class="row g-3 mb-4 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted mb-1">Título do Módulo</label>
                            <input type="text" class="form-control fw-bold" placeholder="Ex: UT1 - Introdução..." @bind="advancedModuleTitle" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted text-nowrap mb-1">Peso do Módulo</label>
                            <div class="input-group">
                                <input type="text" class="form-control text-center" @bind="advancedModuleWeight" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 rounded bg-white shadow-sm" style="border: 1px dashed #ced4da;">
                        <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-list-task me-2"></i>Parâmetros Iniciais (Aplicados às 4 Fases)</h6>

                        <div class="d-flex flex-column gap-2 mb-3">
                            @foreach (var parent in drafts)
                            {
                                <div @onfocusin="() => activeDraftParent = parent">
                                    <div class="d-flex align-items-center mb-1">
                                        <input type="text" class="form-control @(string.IsNullOrWhiteSpace(parent.Text) ? "text-muted" : "border-success fw-bold")"
                                               placeholder="Grupo ou Tarefa principal..."
                                               style="@(string.IsNullOrWhiteSpace(parent.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                               @bind="parent.Text" @bind:event="oninput" @onkeyup="() => CheckListState(parent)" />

                                        @if (!string.IsNullOrWhiteSpace(parent.Text))
                                        {
                                            <div class="input-group input-group-sm ms-2 flex-shrink-0" style="width: 85px;">
                                                <input type="text" inputmode="decimal" class="form-control text-center px-1" placeholder="Peso" @bind="parent.Weight" />
                                                <span class="input-group-text px-1">%</span>
                                            </div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(parent.Text) || parent.Children.Any(f => !string.IsNullOrWhiteSpace(f.Text)))
                                    {
                                        <div class="ms-4 mb-2 d-flex flex-column gap-1">
                                            @foreach (var child in parent.Children)
                                            {
                                                if (!string.IsNullOrWhiteSpace(child.Text) || activeDraftParent == parent)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                        <input type="text" class="form-control form-control-sm @(string.IsNullOrWhiteSpace(child.Text) ? "text-muted" : "border-dark")"
                                                               placeholder="Sub-parâmetro..."
                                                               style="@(string.IsNullOrWhiteSpace(child.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #343a40;")"
                                                               @bind="child.Text" @bind:event="oninput" @onkeyup="() => CheckListState(parent)" />

                                                        @if (!string.IsNullOrWhiteSpace(child.Text))
                                                        {
                                                            <div class="input-group input-group-sm ms-2 flex-shrink-0" style="width: 85px;">

                                                                <input type="text" inputmode="decimal" class="form-control text-center px-1" placeholder="Peso" @bind="child.Weight" />
                                                                <span class="input-group-text px-1">%</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top-0 bg-light" style="border-radius: 0 0 15px 15px;">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-bold" @onclick="CloseAddModuleModal">Cancelar</button>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" @onclick="SaveAdvancedModule" disabled="@isSavingModal">
                        @if (isSavingModal)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar Módulo
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (isWeightModalOpen)
{
    <ModuleWeightManagerModal
        Modules="Modules"
        OnSave="SaveBulkWeights"
        OnCancel="() => isWeightModalOpen = false" />
}


@code {

    #region [ Parameters & Events ]

    [Parameter] public int PathwayTemplateId { get; set; }
    [Parameter] public string ParentTitle { get; set; } = string.Empty;
    [Parameter] public List<BuilderModuleDto> Modules { get; set; } = new();
    [Parameter] public EventCallback OnOpenBadges { get; set; }
    [Parameter] public BuilderMode CurrentMode { get; set; } = BuilderMode.Geral;
    [Parameter] public bool IsTemplateMode { get; set; }

    [Parameter] public EventCallback<(string Title, float Weight, int OrderIndex, List<DraftParent> Drafts)> OnCreateAdvancedModule { get; set; }
    [Parameter] public EventCallback<int> OnDeleteModule { get; set; }
    [Parameter] public EventCallback<BuilderModuleDto> OnUpdateModuleWeight { get; set; }
    [Parameter] public EventCallback<(int ModuleId, ModuleStage Stage, DateTime Date, bool IsStart)> OnUpdateTimeline { get; set; }

    [Parameter] public EventCallback<int> OnDeleteComponent { get; set; }
    [Parameter] public EventCallback<(int ModuleId, BuilderComponentDto Component)> OnSaveTheoreticalEvent { get; set; }
    [Parameter] public EventCallback<(int ModuleId, ModuleStage Stage, List<BuilderComponentDto> UpdatedComponents, Dictionary<int, List<(string Title, float Weight, int OrderIndex)>> NewSubTasks, List<(string Title, float Weight, int OrderIndex, List<(string Title, float Weight, int OrderIndex)> Children)> NewParents)> OnSaveBulkEditEvent { get; set; }

    #endregion

    #region [ UI State Variables ]

    private int expandedModuleId = 0;
    private string newModuleTitle = string.Empty;
    private bool isBadgeModalOpen = false;

    // Modal State
    private BuilderModuleDto? activeModalModule;
    private BuilderComponentDto componentToEdit = new();
    private (ModuleStage Stage, string Title, string Icon)? activeModalStage;
    private bool isSavingModal = false;

    // Local View Control
    private int? expandedComponentId = null;

    // Bulk Edit State
    private bool isEditMode = false;
    private string? validationError;
    private Dictionary<int, List<DraftParent>> editModeNewParents = new();
    private Dictionary<int, List<DraftChild>> editModeNewChildren = new();
    private List<DraftParent> editModeEmptyListParents = new() { new DraftParent() };
    private HashSet<int> editModeDeletedIds = new();
    private Dictionary<int, (string Title, string Description, string PdfFilePath, float Weight)> originalComponentStates = new();
    private bool isUploading = false;

    // Draft State Classes
    public class DraftParent
    {
        public string Text { get; set; } = "";
        public float? Weight { get; set; } = null;
        public int OrderIndex { get; set; }
        public List<DraftChild> Children { get; set; } = new() {
            new DraftChild()
        };
    }

    public class DraftChild
    {
        public string Text { get; set; } = "";
        public float? Weight { get; set; } = null;
        public int OrderIndex { get; set; }
    }

    private List<DraftParent> drafts = new() {
        new DraftParent()
    };

    private DraftParent? activeDraftParent = null;

    /// <summary>
    /// Manages the dynamic addition or removal of draft parents within an existing component during edit mode.
    /// </summary>
    private void CheckEditModeParentsState(int parentId)
    {
        var list = editModeNewParents[parentId];
        if (!string.IsNullOrWhiteSpace(list.Last().Text)) list.Add(new DraftParent());
        else if (list.Count > 1 && string.IsNullOrWhiteSpace(list[^2].Text) && !list[^2].Children.Any(c => !string.IsNullOrWhiteSpace(c.Text)))
            list.RemoveAt(list.Count - 2);
    }

    /// <summary>
    /// Manages the dynamic addition or removal of draft parents when the component list is initially empty.
    /// </summary>
    private void CheckEditModeEmptyParentsState()
    {
        var list = editModeEmptyListParents;
        if (!string.IsNullOrWhiteSpace(list.Last().Text)) list.Add(new DraftParent());
        else if (list.Count > 1 && string.IsNullOrWhiteSpace(list[^2].Text) && !list[^2].Children.Any(c => !string.IsNullOrWhiteSpace(c.Text)))
            list.RemoveAt(list.Count - 2);
    }

    /// <summary>
    /// Manages the dynamic addition or removal of draft children for a given draft parent.
    /// </summary>
    private void CheckEditModeDraftChildState(DraftParent parent)
    {
        var list = parent.Children;
        if (!string.IsNullOrWhiteSpace(list.Last().Text)) list.Add(new DraftChild());
        else if (list.Count > 1 && string.IsNullOrWhiteSpace(list[^2].Text)) list.RemoveAt(list.Count - 2);
    }

    // Static definition of module stages
    private List<(ModuleStage Stage, string Title, string Icon)> stagesToRender = new()
    {
        (ModuleStage.Teorica, "Componente Teórica", "bi-journal-text"),
        (ModuleStage.ObservacaoPassiva, "Observação Passiva", "bi-eye"),
        (ModuleStage.ObservacaoParticipada, "Observação Participada", "bi-people"),
        (ModuleStage.PraticaAssistida, "Prática Assistida", "bi-person-gear"),
        (ModuleStage.PraticaSupervisionada, "Prática Supervisionada", "bi-person-check")
    };

    private bool isAddModuleModalOpen = false;
    private string advancedModuleTitle = string.Empty;
    private float advancedModuleWeight = 100f;

    // Draft Focus Control
    private int? activeFocusParentId;

    /// <summary>
    /// Sets the currently active parent to manage focus and display relevant draft inputs.
    /// </summary>
    private void SetActiveParent(int parentId)
    {
        activeFocusParentId = parentId;
    }

    #endregion

    #region [ Lifecycle Methods ]

    protected override void OnParametersSet()
    {
        if (activeModalModule != null)
        {
            activeModalModule = Modules.FirstOrDefault(m => m.Id == activeModalModule.Id);
        }
    }

    #endregion

    #region [ Module Control & Base Visuals ]

    /// <summary>
    /// Toggles the expanded/collapsed state of a specific module panel.
    /// </summary>
    private void ToggleModule(int moduleId) => expandedModuleId = (expandedModuleId == moduleId) ? 0 : moduleId;

    /// <summary>
    /// Handles changes to the start or end dates of a module's stage timeline.
    /// </summary>
    private async Task HandleDateChange(int moduleId, ModuleStage stage, string? dateStr, bool isStart)
    {
        if (DateTime.TryParse(dateStr, out DateTime newDate))
        {
            await OnUpdateTimeline.InvokeAsync((moduleId, stage, newDate, isStart));
        }
    }

    /// <summary>
    /// Calculates a module's weight relative to the sum of all module weights.
    /// </summary>
    private int GetModulePercentage(BuilderModuleDto mod)
    {
        if (!Modules.Any()) return 0;
        var total = Modules.Sum(m => Math.Max(1, m.Weight));
        return (int)Math.Round((double)Math.Max(1, mod.Weight) / total * 100);
    }

    /// <summary>
    /// Retrieves the timeline information for a specific module and stage.
    /// </summary>
    private ModuleStageTimelineDto? GetTimeline(BuilderModuleDto mod, ModuleStage stage)
    {
        return mod.StageTimelines?.FirstOrDefault(t => t.Stage == stage);
    }

    #endregion

    #region [ Modal & Form Control ]

    /// <summary>
    /// Opens the modal to view or edit parameters for a specific stage within a module.
    /// </summary>
    private void OpenStageModal(BuilderModuleDto mod, (ModuleStage Stage, string Title, string Icon) stageInfo)
    {
        activeModalModule = mod;
        activeModalStage = stageInfo;
        isEditMode = false;
        validationError = null;
        expandedComponentId = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();
        ResetForm();
    }

    /// <summary>
    /// Closes the stage parameters modal and clears all active editing states.
    /// </summary>
    private void CloseStageModal()
    {
        if (isEditMode) CancelEditMode();

        activeModalModule = null;
        activeModalStage = null;
        isEditMode = false;
        validationError = null;
        expandedComponentId = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();
        originalComponentStates.Clear();
        ResetForm();
    }

    /// <summary>
    /// Resets the base component form and clears local drafts.
    /// </summary>
    private void ResetForm()
    {
        componentToEdit = new BuilderComponentDto();
        drafts = new List<DraftParent> { new DraftParent() };
    }

    /// <summary>
    /// Dynamically expands or shrinks the list of parent and child drafts for the advanced module modal.
    /// </summary>
    private void CheckListState(DraftParent currentParent)
    {
        if (!string.IsNullOrWhiteSpace(drafts.Last().Text)) drafts.Add(new DraftParent());
        else if (drafts.Count > 1 && string.IsNullOrWhiteSpace(drafts[^2].Text))
        {
            if (!drafts[^2].Children.Any(f => !string.IsNullOrWhiteSpace(f.Text))) drafts.RemoveAt(drafts.Count - 2);
        }

        if (!string.IsNullOrWhiteSpace(currentParent.Children.Last().Text)) currentParent.Children.Add(new DraftChild());
        else if (currentParent.Children.Count > 1 && string.IsNullOrWhiteSpace(currentParent.Children[^2].Text))
        {
            currentParent.Children.RemoveAt(currentParent.Children.Count - 2);
        }
    }

    /// <summary>
    /// Exits bulk edit mode, discarding any unsaved modifications and restoring original component states.
    /// </summary>
    private void CancelEditMode()
    {
        isEditMode = false;
        activeFocusParentId = null;
        validationError = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();

        if (activeModalModule != null && activeModalStage.HasValue)
        {
            var stageComponents = activeModalModule.Components.Where(c => c.Stage == activeModalStage.Value.Stage).ToList();
            foreach (var c in stageComponents)
            {
                if (originalComponentStates.TryGetValue(c.Id, out var original))
                {
                    c.Title = original.Title;
                    c.Description = original.Description;
                    c.PdfFilePath = original.PdfFilePath;
                    c.Weight = original.Weight;
                }
            }
        }

        originalComponentStates.Clear();
        ResetForm();
        StateHasChanged();
    }

    /// <summary>
    /// Handles file uploads by streaming data to the backend API and setting the resulting secure URL.
    /// </summary>
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        StateHasChanged();

        var file = e.File;
        long maxAllowedSize = 10 * 1024 * 1024; // 10 MB limit

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("api/files/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var secureUrl = await response.Content.ReadAsStringAsync();
                componentToEdit.PdfFilePath = secureUrl.Trim('"');
            }
            else
            {
                validationError = "Erro ao enviar ficheiro para o servidor.";
            }
        }
        catch (Exception ex)
        {
            validationError = "Ocorreu um erro no upload. Verifique o tamanho do ficheiro.";
        }

        isUploading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Calculates the sum of existing children weights plus the drafted children weights.
    /// </summary>
    private float GetChildrenSum(int parentId, List<BuilderComponentDto> existingChildren)
    {
        float sum = existingChildren.Where(c => !editModeDeletedIds.Contains(c.Id)).Sum(c => c.Weight);

        if (editModeNewChildren.TryGetValue(parentId, out var drafts))
        {
            sum += drafts.Where(c => !string.IsNullOrWhiteSpace(c.Text)).Sum(c => c.Weight ?? 0f);
        }

        return (float)Math.Round(sum, 2);
    }


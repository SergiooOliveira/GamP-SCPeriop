@using GamP_SCPeriop.Shared.Data
@using GamP_SCPeriop.Shared.Data.Template
@using GamP_SCPeriop.Shared.Entity.Model
@using GamP_SCPeriop.Shared.Enum
@inject HttpClient Http

<div class="mt-4 card shadow-sm p-4 border-0" style="border-radius: 15px;">

    <!-- Aviso de Validação Global (> ou < que 100%) -->
    @if (Modules.Any() && Modules.Sum(m => m.Weight) != 100)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center p-3 mb-4 rounded">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>
            <div>
                <strong>Atenção:</strong> A soma dos pesos dos módulos está em <strong>@Modules.Sum(m => m.Weight)%</strong>. Deverá ser exatamente 100% antes de finalizar o percurso.
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-primary mb-0">Gestão de Módulos</h5>

        <div class="d-flex gap-2">
            <!-- Novo Botão de Pesos -->
            <button class="btn btn-outline-primary shadow-sm fw-bold d-flex align-items-center" @onclick="OpenWeightModal">
                <i class="bi bi-sliders me-2"></i> Editar Pesos
            </button>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button class="btn btn-warning shadow-sm fw-bold text-dark" @onclick="() => OpenBadgeModal()">
                        <i class="bi bi-award me-1"></i> Gerir Badges
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (Modules.Any())
    {
        <div class="mb-4">
            @foreach (var mod in Modules.OrderBy(m => m.OrderIndex))
            {
                var isExpanded = expandedModuleId == mod.Id;
                bool isDraggingThisModule = draggingModuleId == mod.Id;

                <!-- CAIXA BASE: Onde acontece o ondragenter para a troca em tempo real -->
                <div @key="mod.Id" class="mb-3 rounded"
                     style="@(isDraggingThisModule ? "background-color: rgba(0,0,0,0.03); border: 2px dashed #adb5bd;" : "transition: all 0.2s ease;")"
                     @ondrop="HandleModuleDrop"
                     ondragover="event.preventDefault();"
                     @ondragenter="@(() => HandleModuleDragEnter(mod.Id))">

                    <!-- CAPA FANTASMA (0.4 de opacidade se estiver a ser arrastado) -->
                    <div class="card border-0 shadow-sm" style="border-radius: 10px; overflow: hidden; @(isDraggingThisModule ? "opacity: 0.4;" : "")">
                    
                        <!-- CABEÇALHO DO MÓDULO -->
                        <div class="card-header bg-white border-0 p-0 d-flex align-items-center pe-4">
                        
                            <!-- PEGA (DRAG HANDLE) + Proteção ondragend -->
                            <div draggable="true" 
                                 @ondragstart="() => HandleModuleDragStart(mod.Id)" 
                                 @ondragend="ResetModuleDrag"
                                 class="d-flex align-items-center justify-content-center ps-4 pe-2" 
                                 style="cursor: grab;">
                                <i class="bi bi-grip-vertical fs-5 text-muted hover-primary"></i>
                            </div>

                            <!-- Botão de Toggle -->
                            <button class="btn btn-link text-decoration-none fw-bold text-dark text-start flex-grow-1 py-3 pe-3 shadow-none"
                                    type="button" @onclick="() => ToggleModule(mod.Id)">
                                <i class="bi bi-folder2-open text-primary me-3 fs-5"></i> @mod.Title
                            </button>

                            <!-- PESO -->
                            <div class="d-flex align-items-center border-end pe-3 me-3 flex-shrink-0" @onclick:stopPropagation="true">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2" style="font-size: 0.85rem;">
                                    Peso: <strong class="ms-1 text-dark">@mod.Weight%</strong>
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3 flex-shrink-0">
                                @if (CurrentMode == BuilderMode.Template || !mod.IsFromTemplate)
                                {
                                    <button class="btn btn-sm text-danger border-0 p-1 shadow-none" title="Eliminar Módulo"
                                            @onclick="() => OnDeleteModule.InvokeAsync(mod.Id)" @onclick:stopPropagation="true">
                                        <i class="bi bi-trash3 fs-5"></i>
                                    </button>
                                }
                                <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="cursor: pointer;" @onclick="() => ToggleModule(mod.Id)"></i>
                            </div>
                        </div>

                        <!-- CORPO DO MÓDULO (Fases) -->
                        @if (isExpanded)
                        {
                            <div class="card-body p-0 border-top">
                                <div class="list-group list-group-flush">
                                    @foreach (var stageInfo in stagesToRender)
                                    {
                                        var count = mod.Components?.Count(c => c.Stage == stageInfo.Stage) ?? 0;

                                        <div class="list-group-item d-flex flex-column border-0 border-bottom p-0" style="background-color: #f8f9fa;">
                                            <div class="d-flex justify-content-between align-items-center px-4 py-3">

                                                <!-- Botão que vai abrir o Modal -->
                                                <button type="button" class="btn btn-link text-decoration-none p-0 d-flex align-items-center flex-grow-1 text-start shadow-none"
                                                        @onclick="() => OpenStageModal(mod, stageInfo)">
                                                    <i class="bi @stageInfo.Icon me-3 text-secondary fs-5"></i>
                                                    <span class="fw-semibold text-dark">@stageInfo.Title</span>
                                                </button>

                                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                    <!-- DATAS / TIMELINE -->
                                                    @if (CurrentMode != BuilderMode.Template && stageInfo.Stage != ModuleStage.Teorica)
                                                    {
                                                        var timeline = GetTimeline(mod, stageInfo.Stage);

                                                        <div class="d-flex align-items-center bg-white border shadow-sm flex-nowrap me-2"
                                                             style="border-radius: 8px; padding: 2px 6px;"
                                                             @onclick:stopPropagation="true">

                                                            <input type="date" class="form-control form-control-sm border-0 text-center text-muted fw-semibold p-0 shadow-none"
                                                                   style="width: 100px; font-size: 0.75rem; background: transparent;"
                                                                   value="@(timeline.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                                   @onchange="(e) => HandleDateChange(mod.Id, stageInfo.Stage, e.Value?.ToString(), true)"
                                                                   title="Data de Início" />

                                                            <i class="bi bi-arrow-right-short text-muted mx-1"></i>

                                                            <input type="date" class="form-control form-control-sm border-0 text-center text-muted fw-semibold p-0 shadow-none"
                                                                   style="width: 100px; font-size: 0.75rem; background: transparent;"
                                                                   value="@(timeline.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                                                                   min="@(timeline.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                                   @onchange="(e) => HandleDateChange(mod.Id, stageInfo.Stage, e.Value?.ToString(), false)"
                                                                   title="Data de Fim" />
                                                        </div>
                                                    }

                                                    @if (count > 0)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 border border-success border-opacity-25 flex-shrink-0">@count itens</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border rounded-pill px-3 py-1 flex-shrink-0">Vazio</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- ADICIONAR MÓDULO -->
    <div class="mt-4 text-end">
        <button @onclick="OpenAddModuleModal" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #6A96A6; border-radius: 8px;">
            <i class="bi bi-plus-circle me-2"></i> Adicionar Novo Módulo
        </button>
    </div>
</div>

<!-- ============================================== -->
<!-- O MODAL DAS BADGES (NOVO)                      -->
<!-- ============================================== -->
@if (isBadgeModalOpen)
{
    <BadgeManagerModalComponent
        OnClose="CloseBadgeModal"
        AvailableModules="Modules"
        CurrentPathwayTemplateId="PathwayTemplateId" />
}

<!-- ============================================== -->
<!-- JANELA MODAL (FASES E TAREFAS)                 -->
<!-- ============================================== -->
@if (activeModalModule != null && activeModalStage.HasValue)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.6); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 15px; background-color: #f4f7f6;">

                <!-- Cabeçalho Modal -->
                <div class="modal-header border-bottom shadow-sm pb-3 pt-4 px-4 bg-white" style="border-radius: 15px 15px 0 0;">
                    <div class="d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-light text-secondary border shadow-sm px-3 py-1 rounded-pill d-flex align-items-center" style="font-size: 0.75rem;">
                                <i class="bi bi-signpost-split text-primary me-2"></i>
                                @ParentTitle
                                <i class="bi bi-chevron-right mx-2 text-muted" style="font-size: 0.65rem;"></i>
                                <i class="bi bi-folder2-open me-1"></i>@activeModalModule.Title
                            </span>
                        </div>
                        <h4 class="modal-title fw-bolder text-dark mb-0" style="letter-spacing: -0.5px;">
                            <i class="bi @activeModalStage.Value.Icon text-primary me-2"></i>@activeModalStage.Value.Title
                        </h4>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseStageModal" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <!-- Edit Modal Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded shadow-sm border bg-white">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-ui-checks-grid fs-5 text-secondary me-2"></i>
                            <h6 class="text-uppercase fw-bold text-secondary mb-0" style="letter-spacing: 0.5px;">Parâmetros da Fase</h6>
                        </div>

                        <div class="d-flex gap-2">
                            @if (!isEditMode)
                            {                                
                                <button class="btn btn-sm btn-primary shadow-sm border-0 text-white fw-semibold d-flex align-items-center px-3"
                                        @onclick="ToggleEditMode">
                                    <i class="bi bi-pencil-square me-2"></i> Editar Fase
                                </button>                                    
                            }
                            else if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                            {
                                // Calcula o Total
                                float parentSum = (float)Math.Round(activeModalModule.Components.Where(c => c.Stage == activeModalStage.Value.Stage && c.ParentComponentId == null && !editModeDeletedIds.Contains(c.Id)).Sum(c => c.Weight), 2);

                                <div class="d-flex align-items-center">                                    
                                    <span class="badge @(parentSum == 100 ? "bg-success" : "bg-danger") px-3 py-2 fs-6 shadow-sm border border-@(parentSum == 100 ? "success" : "danger")" style="line-height: 1;">
                                        Total: @parentSum%
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Mensagem de Validação -->
                    @if (!string.IsNullOrEmpty(validationError))
                    {
                        <div class="alert alert-danger py-2 mb-3 shadow-sm d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Atenção:</strong>&nbsp;@validationError
                        </div>
                    }

                    <!-- Lista de Tarefas -->
                    @if (activeModalModule.Components != null && activeModalModule.Components.Any(c => c.Stage == activeModalStage.Value.Stage))
                    {
                        <div class="list-group mb-4 shadow-sm" style="border-radius: 8px;">
                            @{
                                var stageComponents = activeModalModule.Components.Where(c => c.Stage == activeModalStage.Value.Stage).ToList();
                                var topLevel = stageComponents.Where(c => c.ParentComponentId == null).OrderBy(c => c.OrderIndex).ToList();
                            }

                            @foreach (var comp in topLevel)
                            {
                                // Salta a renderização se tiver sido "apagado" temporariamente no modo edição
                                if (editModeDeletedIds.Contains(comp.Id)) continue;

                                var children = stageComponents.Where(c => c.ParentComponentId == comp.Id).OrderBy(c => c.OrderIndex).ToList();
                                var hasAdminChildren = children.Any(c => c.IsFromTemplate);

                                if (isEditMode)
                                {
                                    <!-- MODO EDIÇÃO: Pai -->
                                    bool isDraggingThisParent = draggingParentId == comp.Id && draggingChildId == null;

                                    <div @key="comp.Id" class="mb-1 p-1 rounded"
                                         style="@(isDraggingThisParent ? "background-color: rgba(0,0,0,0.03); border: 2px dashed #adb5bd;" : "transition: all 0.2s ease;")"
                                         @ondrop="HandleDrop"
                                         ondragover="event.preventDefault();">

                                        <!-- 1. CAPA FANTASMA: Reduzimos a opacidade em vez de a esconder totalmente -->
                                        <div style="@(isDraggingThisParent ? "opacity: 0.4;" : "")">
            
                                            <!-- 2. NOVO ALVO DO PAI: O evento "ondragenter" está AGORA SÓ NO CABEÇALHO! -->
                                            <div class="d-flex align-items-start mb-1" @ondragenter="@(() => HandleDragEnter(comp.Id))">
                
                                                <!-- 3. PEGA + PROTEÇÃO DE CANCELAMENTO: Adicionámos o @ondragend -->
                                                <div draggable="true" 
                                                     @ondragstart="() => HandleDragStart(comp.Id)" 
                                                     @ondragend="ResetDrag"
                                                     class="d-flex align-items-center justify-content-center me-2 pt-1" 
                                                     style="cursor: grab;">
                                                    <i class="bi bi-grip-vertical fs-5 text-muted hover-primary"></i>
                                                </div>

                                                <div class="flex-grow-1">
                                                    <input type="text" class="form-control border-success fw-bold mb-1 shadow-none"
                                                           @bind="comp.Title"
                                                           @onfocus="() => SetActiveParent(comp.Id)" />

                                                    @if (activeModalStage.Value.Stage == ModuleStage.Teorica)
                                                    {
                                                        <textarea class="form-control form-control-sm text-muted mb-1" rows="2" placeholder="Descrição ou instruções..." @bind="comp.Description"></textarea>
                                                        <input class="form-control form-control-sm text-muted" placeholder="Link do Documento..." @bind="comp.PdfFilePath" />
                                                    }
                                                </div>

                                                @if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                {
                                                    <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                        <input type="text" inputmode="numeric" class="form-control text-center px-1" style="width: 30px;" 
                                                                @bind="comp.Weight" 
                                                                disabled="@(CurrentMode != BuilderMode.Template && comp.IsFromTemplate)" />
                                                        <span class="input-group-text px-1">%</span>
                                                    </div>
                                                }

                                                @if (CurrentMode == BuilderMode.Template || !comp.IsFromTemplate)
                                                {
                                                    <button class="btn btn-link text-danger p-0 ms-1 flex-shrink-0" @onclick="() => editModeDeletedIds.Add(comp.Id)"><i class="bi bi-x-lg fs-5"></i></button>
                                                }
                                            </div>

                                            <!-- COLCHETE DOS FILHOS E RASCUNHOS -->
                                            @{
                                                bool hasExistingChildren = children.Any(c => !editModeDeletedIds.Contains(c.Id));
                                                bool hasVisibleDraft = activeFocusParentId == comp.Id && editModeNewChildren.ContainsKey(comp.Id);

                                                bool showBracket = activeModalStage.Value.Stage != ModuleStage.Teorica && (hasExistingChildren || hasVisibleDraft);

                                                float childSum = showBracket ? GetChildrenSum(comp.Id, children) : 0;
                                                string colorClass = childSum == 100 ? "success" : (childSum == 0 ? "secondary" : "danger");
                                            }

                                            <div class="position-relative @(showBracket ? $"ms-4 ps-2 py-1 mb-1 mt-1 border-start border-3 border-{colorClass}" : "ms-4")" style="border-radius: 6px 0 0 6px;">

                                                @if (showBracket)
                                                {
                                                    <!-- A BADGE VERTICAL -->
                                                    <div class="position-absolute d-flex align-items-center justify-content-center"
                                                         style="left: -38px; top: 50%; transform: translateY(-50%) rotate(-90deg); width: 80px; height: 24px; pointer-events: none;">
                                                        <span class="badge bg-@colorClass shadow-sm" style="font-size: 0.7rem; letter-spacing: 0.5px;">@childSum%</span>
                                                    </div>
                                                }

                                                <!-- MODO EDIÇÃO: Filhos Existentes -->
                                                @foreach (var child in children)
                                                {
                                                    if (editModeDeletedIds.Contains(child.Id)) continue;
                
                                                    bool isDraggingThisChild = draggingParentId == comp.Id && draggingChildId == child.Id;

                                                    <div @key="child.Id" class="mb-1 p-1 rounded"
                                                         style="@(isDraggingThisChild ? "background-color: rgba(0,0,0,0.03); border: 2px dashed #adb5bd;" : "transition: all 0.2s ease;")"
                                                         @ondrop="HandleDrop"
                                                         ondragover="event.preventDefault();"
                                                         @ondragenter="@(() => HandleDragEnter(comp.Id, child.Id))">

                                                        <!-- CAPA FANTASMA DO FILHO (0.4) -->
                                                        <div class="d-flex align-items-center" style="@(isDraggingThisChild ? "opacity: 0.4;" : "")">
                        
                                                            <!-- PEGA DO FILHO + PROTEÇÃO DE CANCELAMENTO (@ondragend) -->
                                                            <div draggable="true" 
                                                                 @ondragstart="() => HandleDragStart(comp.Id, child.Id)" 
                                                                 @ondragend="ResetDrag"
                                                                 class="me-1 d-flex" 
                                                                 style="cursor: grab;">
                                                                <i class="bi bi-grip-vertical fs-5 text-muted"></i>
                                                            </div>

                                                            <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                            <input type="text" class="form-control border-dark shadow-none"
                                                                   @bind="child.Title"
                                                                   @onfocus="() => SetActiveParent(comp.Id)" />

                                                            @if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                            {
                                                                if (CurrentMode == BuilderMode.Template || !hasAdminChildren)
                                                                {
                                                                    <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                                        <input type="text" inputmode="numeric" class="form-control text-center px-1" style="width: 30px;" @bind="child.Weight" disabled="@(CurrentMode != BuilderMode.Template && child.IsFromTemplate)" />
                                                                        <span class="input-group-text px-1">%</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    if (child.IsFromTemplate)
                                                                    {
                                                                        <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                                            <input type="text" inputmode="numeric" class="form-control text-center px-1" style="width: 30px;" @bind="child.Weight" disabled="true" />
                                                                            <span class="input-group-text px-1">%</span>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="ms-2 flex-shrink-0">
                                                                            <span class="badge bg-light text-secondary border px-2 py-1">0% (Descritivo)</span>
                                                                        </div>
                                                                    }
                                                                }
                                                            }

                                                            @if (CurrentMode == BuilderMode.Template || !child.IsFromTemplate)
                                                            {
                                                                <button class="btn btn-link text-danger p-0 ms-1 flex-shrink-0" @onclick="() => editModeDeletedIds.Add(child.Id)"><i class="bi bi-x-lg fs-5"></i></button>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <!-- MODO EDIÇÃO: Rascunho para Novos Filhos -->
                                                @if (activeFocusParentId == comp.Id && editModeNewChildren.ContainsKey(comp.Id))
                                                {
                                                    foreach (var newChild in editModeNewChildren[comp.Id])
                                                    {
                                                        <div class="d-flex align-items-center mb-1 p-1">
                                                            <div class="me-1" style="width: 24px;"></div>
                                                            <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                            <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newChild.Text) ? "draft-empty" : "draft-filled-success")"
                                                                   placeholder="Adicionar novo sub-parâmetro..."
                                                                   style="@(string.IsNullOrWhiteSpace(newChild.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                                                   @bind="newChild.Text"
                                                                   @bind:event="oninput"
                                                                   @onkeyup="() => CheckEditModeChildrenState(comp.Id)"
                                                                   @onfocus="() => SetActiveParent(comp.Id)" />

                                                            @if (!string.IsNullOrWhiteSpace(newChild.Text) && activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                            {
                                                                if (CurrentMode == BuilderMode.Template || !hasAdminChildren)
                                                                {
                                                                    <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                                        <input type="text" inputmode="decimal" class="form-control text-center px-1" @bind="newChild.Weight" />
                                                                        <span class="input-group-text px-1">%</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="ms-2 flex-shrink-0">
                                                                        <span class="badge bg-light text-secondary border px-2 py-1">0% (Descritivo)</span>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>

                                            <!-- MODO EDIÇÃO: Rascunho para Novos Pais -->
                                            @if (activeFocusParentId == comp.Id && editModeNewParents.ContainsKey(comp.Id))
                                            {
                                                foreach (var newParent in editModeNewParents[comp.Id])
                                                {
                                                    <div class="d-flex align-items-center mb-1 mt-3 p-1">
                                                        <div class="me-1" style="width: 24px;"></div>
                                                        <div class="flex-grow-1">
                                                            <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newParent.Text) ? "draft-empty" : "border-success fw-bold")"
                                                                   placeholder="Adicionar novo parâmetro principal aqui..."
                                                                   style="@(string.IsNullOrWhiteSpace(newParent.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                                                   @bind="newParent.Text" @bind:event="oninput" @onkeyup="() => CheckEditModeParentsState(comp.Id)" @onfocus="() => SetActiveParent(comp.Id)" />
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(newParent.Text) && activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                        {
                                                            <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                                <input type="text" class="form-control text-center px-1" placeholder="Peso" @bind="newParent.Weight" />
                                                                <span class="input-group-text px-1">%</span>
                                                            </div>
                                                        }
                                                    </div>

                                                    <!-- A CASCATA: Aparece se o Pai tiver texto OU se já tiver filhos escritos -->
                                                    @if (!string.IsNullOrWhiteSpace(newParent.Text) || newParent.Children.Any(c => !string.IsNullOrWhiteSpace(c.Text)))
                                                    {
                                                        <div class="position-relative ms-5 ps-2 py-1 mb-2 mt-1 border-start border-3 border-secondary" style="border-radius: 6px 0 0 6px;">
                                                            @foreach (var newChild in newParent.Children)
                                                            {
                                                                <div class="d-flex align-items-center mb-1 p-1" @key="newChild">
                                                                    <div class="me-1" style="width: 24px;"></div>
                                                                    <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                                    <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newChild.Text) ? "draft-empty" : "draft-filled-success")"
                                                                           placeholder="Adicionar sub-parâmetro..."
                                                                           style="@(string.IsNullOrWhiteSpace(newChild.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                                                           @bind="newChild.Text" @bind:event="oninput" @onkeyup="() => CheckEditModeDraftChildState(newParent)" @onfocus="() => SetActiveParent(comp.Id)" />

                                                                    @if (!string.IsNullOrWhiteSpace(newChild.Text) && activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                                    {
                                                                        <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                                            <input type="text" inputmode="decimal" class="form-control text-center px-1" placeholder="Peso" @bind="newChild.Weight" @bind:event="oninput"/>
                                                                            <span class="input-group-text px-1">%</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            }

                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- MODO LEITURA: A grelha limpa -->
                                    bool isTeorica = activeModalStage.Value.Stage == ModuleStage.Teorica;
                                    bool hasDetails = !string.IsNullOrWhiteSpace(comp.Description) || !string.IsNullOrWhiteSpace(comp.PdfFilePath);
                                    bool canExpand = isTeorica && hasDetails;

                                    <div class="list-group-item py-3 border-0 border-bottom bg-light"
                                         style="@(canExpand ? "cursor: pointer;" : "")" 
                                         @onclick="() => { if (canExpand) expandedComponentId = (expandedComponentId == comp.Id ? null : comp.Id); }">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center pe-3 flex-grow-1">
                                                <i class="bi @(string.IsNullOrEmpty(comp.PdfFilePath) ? (isTeorica ? "bi-journal-text" : "bi-card-text") : "bi-file-earmark-pdf text-danger") fs-5 me-3 @(string.IsNullOrEmpty(comp.PdfFilePath) ? "text-secondary" : "")"></i>
                                                <span class="fw-bold text-dark text-wrap">@comp.Title</span>
                                            </div>
                                            
                                            <!-- Os pesos só aparecem se NÃO for teórica -->
                                            @if (!isTeorica)
                                            {
                                                <div class="d-flex align-items-center gap-1 me-2 pe-2">
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.75rem;">@comp.Weight%</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- ÁREA EXPANSÍVEL DA TEÓRICA -->
                                    @if (expandedComponentId == comp.Id && canExpand)
                                    {
                                        <div class="p-3 bg-white border-bottom border-start border-4 border-primary">
                                            @if (!string.IsNullOrWhiteSpace(comp.Description))
                                            {
                                                <p class="text-muted small mb-2">@comp.Description</p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(comp.PdfFilePath))
                                            {
                                                <a href="@comp.PdfFilePath" target="_blank" class="btn btn-sm btn-outline-danger mt-1">
                                                    <i class="bi bi-file-pdf me-1"></i> Ver Ficheiro
                                                </a>
                                            }
                                        </div>
                                    }

                                    @foreach (var child in children)
                                    {
                                        bool isDescriptive = child.Weight == 0;

                                        <div class="list-group-item d-flex justify-content-between align-items-center py-2 border-0 border-bottom @(isDescriptive ? "ms-5" : "ms-4")">
                                            <div class="d-flex align-items-center pe-3 flex-grow-1">
                                                @if (isDescriptive)
                                                {
                                                    <!-- Design Escuro + Seta Diferente para os Descritivos -->
                                                    <i class="bi bi-chevron-right text-dark fs-6 me-3 flex-shrink-0"></i>
                                                    <span class="text-dark text-wrap" style="font-size: 0.90rem;">@child.Title</span>
                                                }
                                                else
                                                {
                                                    <!-- Design Normal para os Oficiais (Avaliados) -->
                                                    <i class="bi bi-arrow-return-right text-secondary fs-6 me-3 flex-shrink-0"></i>
                                                    <span class="fw-semibold text-dark text-wrap" style="font-size: 0.95rem;">@child.Title</span>
                                                }
                                            </div>

                                            @if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                                            {
                                                <div class="d-flex align-items-center gap-1 me-2 pe-2">
                                                    @if (isDescriptive)
                                                    {
                                                        <!-- Pílula Escura a destacar que é apenas Descritivo -->
                                                        <span class="badge bg-dark text-white px-2 py-1 shadow-sm" style="font-size: 0.7rem;">
                                                            <i class="bi bi-info-circle me-1"></i>Descritivo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.7rem;">@child.Weight%</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                    else
                    {
                        @if (isEditMode)
                        {
                            foreach (var newParent in editModeEmptyListParents)
                            {
                                <div class="d-flex align-items-center mb-2 mt-2 p-1">
                                    <div class="flex-grow-1">
                                        <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newParent.Text) ? "draft-empty" : "border-success fw-bold")"
                                               placeholder="Adicionar o primeiro parâmetro principal..."
                                               style="@(string.IsNullOrWhiteSpace(newParent.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                               @bind="newParent.Text" @bind:event="oninput" @onkeyup="() => CheckEditModeEmptyParentsState()" @onfocus="() => SetActiveParent(0)" />
                                    </div>
                                    @if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                                    {
                                        <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                            <input type="text" inputmode="decimal" class="form-control text-center px-1" placeholder="Peso" @bind="newParent.Weight" />
                                            <span class="input-group-text px-1">%</span>
                                        </div>
                                    }
                                </div>

                                <!-- A CASCATA PARA A LISTA VAZIA -->
                                @if (!string.IsNullOrWhiteSpace(newParent.Text) || newParent.Children.Any(c => !string.IsNullOrWhiteSpace(c.Text)))
                                {
                                    <div class="position-relative ms-4 ps-2 py-1 mb-2 mt-1 border-start border-3 border-secondary" style="border-radius: 6px 0 0 6px;">
                                        @foreach (var newChild in newParent.Children)
                                        {
                                            <div class="d-flex align-items-center mb-1 p-1">
                                                <div class="me-1" style="width: 24px;"></div>
                                                <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newChild.Text) ? "draft-empty" : "draft-filled-success")"
                                                       placeholder="Adicionar sub-parâmetro..."
                                                       style="@(string.IsNullOrWhiteSpace(newChild.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                                       @bind="newChild.Text" @bind:event="oninput" @onkeyup="() => CheckEditModeDraftChildState(newParent)" @onfocus="() => SetActiveParent(0)" />

                                                @if (!string.IsNullOrWhiteSpace(newChild.Text) && activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                {
                                                    <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                        <input type="text" inputmode="decimal" class="form-control text-center px-1" placeholder="Peso" @bind="newChild.Weight" />
                                                        <span class="input-group-text px-1">%</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="alert alert-light text-center border mb-4" style="border-radius: 8px;">
                                <span class="text-muted small">Nenhum item adicionado a esta fase. Clique em Editar para começar.</span>
                            </div>
                        }
                    }

                    <!-- Adicionar Novos Componentes -->
                    @if (!isEditMode)
                    {
                        if (activeModalStage.Value.Stage == ModuleStage.Teorica)
                        {
                            <div class="p-4 rounded bg-white shadow-sm mt-4" style="border: 1px dashed #ced4da;">
                            
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold text-primary mb-0">Adicionar Nova Componente Teórica</h6>
                                    <button class="btn btn-sm btn-light border" @onclick="ResetForm">Limpar</button>
                                </div>

                                <div class="mb-3">
                                    <input class="form-control shadow-sm border-0 bg-light fw-bold" placeholder="Título (Ex: Manual de Ventilação)..." @bind="componentToEdit.Title" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">Instruções / Descrição (Opcional)</label>
                                    <textarea class="form-control shadow-sm border-0 bg-light" rows="3" placeholder="Ex: Leiam o capítulo 3..." @bind="componentToEdit.Description"></textarea>
                                </div>

                                <!-- O TEU BLOCO DE UPLOAD AQUI -->
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">URL ou Anexo (Opcional)</label>

                                    <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-link-45deg"></i></span>

                                        <input class="form-control border-0 bg-light" placeholder="Ex: https://youtube.com/..." @bind="componentToEdit.PdfFilePath" disabled="@isUploading" />

                                        <label class="btn btn-secondary border-0 m-0 d-flex align-items-center px-3" style="cursor: pointer; background-color: #6A96A6;">
                                            <i class="bi bi-cloud-arrow-up me-2"></i> Explorar...
                                            <InputFile OnChange="HandleFileUpload" class="d-none" accept=".pdf,.doc,.docx" />
                                        </label>
                                    </div>

                                    @if (isUploading)
                                    {
                                        <div class="form-text text-primary small mt-2 d-flex align-items-center fw-semibold">
                                            <div class="spinner-border spinner-border-sm me-2" role="status"></div> A enviar ficheiro para o servidor...
                                        </div>
                                    }
                                </div>
                                <!-- FIM DO TEU BLOCO -->

                                <div class="text-end mt-4">
                                    <button class="btn text-white px-4 shadow-sm" style="background-color: #6A96A6;" @onclick="SaveComponent" disabled="@(isSavingModal || isUploading)">
                                        <i class="bi bi-save me-2"></i> @(isSavingModal ? "A Guardar..." : "Guardar")
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Footer -->
                @if (isEditMode)
                {
                    <div class="modal-footer border-top bg-light" style="border-radius: 0 0 15px 15px;">
                        <button class="btn btn-outline-secondary fw-bold px-4" @onclick="CancelEditMode">
                            Cancelar
                        </button>
                        <button class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #198754;" @onclick="SaveChangesBulk">
                            <i class="bi bi-check-circle me-2"></i> Guardar Alterações
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
}



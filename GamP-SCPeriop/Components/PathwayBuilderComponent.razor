@using GamP_SCPeriop.Shared.Entity.Model
@using GamP_SCPeriop.Shared.Enum
@inject HttpClient Http

<div class="mt-4 card shadow-sm p-4 border-0" style="border-radius: 15px;">

    <!-- Aviso de Validação Global (> ou < que 100%) -->
    @if (Modules.Any() && Modules.Sum(m => m.Weight) != 100)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center p-3 mb-4 rounded">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>
            <div>
                <strong>Atenção:</strong> A soma dos pesos dos módulos está em <strong>@Modules.Sum(m => m.Weight)%</strong>. Deverá ser exatamente 100% antes de finalizar o percurso.
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-primary mb-0">Gestão de Módulos</h5>

        <div class="d-flex gap-2">
            <!-- Novo Botão de Pesos (Visível se não for Template) -->
            @if (CurrentMode != BuilderMode.Template)
            {
                <button class="btn btn-outline-primary shadow-sm fw-bold d-flex align-items-center" @onclick="OpenWeightModal">
                    <i class="bi bi-sliders me-2"></i> Editar Pesos
                </button>
            }

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button class="btn btn-warning shadow-sm fw-bold text-dark" @onclick="() => OpenBadgeModal()">
                        <i class="bi bi-award me-1"></i> Gerir Badges
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @if (Modules.Any())
    {
        <div class="mb-4">
            @foreach (var mod in Modules)
            {
                var isExpanded = expandedModuleId == mod.Id;

                <div class="card border-0 shadow-sm mb-3" style="border-radius: 10px; overflow: hidden;">
                    <!-- CABEÇALHO DO MÓDULO -->
                    <div class="card-header bg-white border-0 p-0 d-flex align-items-center pe-4">
                        <button class="btn btn-link text-decoration-none fw-bold text-dark text-start flex-grow-1 p-3 px-4 shadow-none"
                                type="button" @onclick="() => ToggleModule(mod.Id)">
                            <i class="bi bi-folder2-open text-primary me-3 fs-5"></i> @mod.Title
                        </button>

                        <!-- PESO (Escondido se for Template) -->
                        @if (CurrentMode != BuilderMode.Template)
                        {
                            <div class="d-flex align-items-center border-end pe-3 me-3 flex-shrink-0" @onclick:stopPropagation="true">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2" style="font-size: 0.85rem;">
                                    Peso: <strong class="ms-1 text-dark">@mod.Weight%</strong>
                                </span>
                            </div>
                        }

                        <div class="d-flex align-items-center gap-3 flex-shrink-0">
                            @if (CurrentMode == BuilderMode.Template || !mod.IsFromTemplate)
                            {
                                <button class="btn btn-sm text-danger border-0 p-1 shadow-none" title="Eliminar Módulo"
                                        @onclick="() => OnDeleteModule.InvokeAsync(mod.Id)" @onclick:stopPropagation="true">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </button>
                            }
                            <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="cursor: pointer;" @onclick="() => ToggleModule(mod.Id)"></i>
                        </div>
                    </div>

                    <!-- CORPO DO MÓDULO (Fases) -->
                    @if (isExpanded)
                    {
                        <div class="card-body p-0 border-top">
                            <div class="list-group list-group-flush">
                                @foreach (var stageInfo in stagesToRender)
                                {
                                    var count = mod.Components.Count(c => c.Stage == stageInfo.Stage);

                                    <div class="list-group-item d-flex flex-column border-0 border-bottom p-0" style="background-color: #f8f9fa;">
                                        <div class="d-flex justify-content-between align-items-center px-4 py-3">

                                            <!-- Botão que vai abrir o Modal -->
                                            <button type="button" class="btn btn-link text-decoration-none p-0 d-flex align-items-center flex-grow-1 text-start shadow-none"
                                                    @onclick="() => OpenStageModal(mod, stageInfo)">
                                                <i class="bi @stageInfo.Icon me-3 text-secondary fs-5"></i>
                                                <span class="fw-semibold text-dark">@stageInfo.Title</span>
                                            </button>

                                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                <!-- DATAS / TIMELINE (Escondido se for Template ou Teórica) -->
                                                @if (CurrentMode != BuilderMode.Template && stageInfo.Stage != ModuleStage.Teorica)
                                                {
                                                    var timeline = GetTimeline(mod, stageInfo.Stage);

                                                    <!-- Cápsula compacta para as datas -->
                                                    <div class="d-flex align-items-center bg-white border shadow-sm flex-nowrap me-2"
                                                         style="border-radius: 8px; padding: 2px 6px;"
                                                         @onclick:stopPropagation="true">

                                                        <input type="date" class="form-control form-control-sm border-0 text-center text-muted fw-semibold p-0 shadow-none"
                                                               style="width: 100px; font-size: 0.75rem; background: transparent;"
                                                               value="@timeline?.StartDate.ToString("yyyy-MM-dd")"
                                                               @onchange="(e) => HandleDateChange(mod.Id, stageInfo.Stage, e.Value?.ToString(), true)"
                                                               title="Data de Início" />

                                                        <i class="bi bi-arrow-right-short text-muted mx-1"></i>

                                                        <input type="date" class="form-control form-control-sm border-0 text-center text-muted fw-semibold p-0 shadow-none"
                                                               style="width: 100px; font-size: 0.75rem; background: transparent;"
                                                               value="@timeline?.EndDate.ToString("yyyy-MM-dd")"
                                                               @onchange="(e) => HandleDateChange(mod.Id, stageInfo.Stage, e.Value?.ToString(), false)"
                                                               title="Data de Fim" />
                                                    </div>
                                                }

                                                @if (count > 0)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 border border-success border-opacity-25 flex-shrink-0">@count itens</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1 flex-shrink-0">Vazio</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ADICIONAR MÓDULO -->
    <div class="mt-4 text-end">
        <button @onclick="OpenAddModuleModal" class="btn text-white fw-bold px-4 shadow-sm" style="background-color: #6A96A6; border-radius: 8px;">
            <i class="bi bi-plus-circle me-2"></i> Adicionar Novo Módulo
        </button>
    </div>
</div>

<!-- ============================================== -->
<!-- O MODAL DAS BADGES (NOVO)                      -->
<!-- ============================================== -->
@if (isBadgeModalOpen)
{
    <BadgeManagerModalComponent
        OnClose="CloseBadgeModal"
        AvailableModules="Modules"
        CurrentPathwayTemplateId="PathwayTemplateId" />
}

<!-- ============================================== -->
<!-- JANELA MODAL (FASES E TAREFAS)                 -->
<!-- ============================================== -->
@if (activeModalModule != null && activeModalStage.HasValue)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.6); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 15px; background-color: #f4f7f6;">

                <!-- Cabeçalho Modal -->
                <div class="modal-header border-bottom shadow-sm pb-3 pt-4 px-4 bg-white" style="border-radius: 15px 15px 0 0;">
                    <div class="d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-light text-secondary border shadow-sm px-3 py-1 rounded-pill d-flex align-items-center" style="font-size: 0.75rem;">
                                <i class="bi bi-signpost-split text-primary me-2"></i>
                                @ParentTitle
                                <i class="bi bi-chevron-right mx-2 text-muted" style="font-size: 0.65rem;"></i>
                                <i class="bi bi-folder2-open me-1"></i>@activeModalModule.Title
                            </span>
                        </div>
                        <h4 class="modal-title fw-bolder text-dark mb-0" style="letter-spacing: -0.5px;">
                            <i class="bi @activeModalStage.Value.Icon text-primary me-2"></i>@activeModalStage.Value.Title
                        </h4>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseStageModal" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <!-- BARRA DE FERRAMENTAS (Substitui os "Controlos de Topo") -->
                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded shadow-sm border bg-white">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-ui-checks-grid fs-5 text-secondary me-2"></i>
                            <h6 class="text-uppercase fw-bold text-secondary mb-0" style="letter-spacing: 0.5px;">Parâmetros da Fase</h6>
                        </div>

                        <div class="d-flex gap-2">
                            @if (!isEditMode)
                            {
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        @if (activeModalStage.Value.CopyFromStage.HasValue)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary fw-semibold d-flex align-items-center px-3"
                                                    @onclick="CopyComponents" disabled="@isCopying">
                                                @if (isCopying)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-copy me-2"></i>
                                                }
                                                Copiar Anterior
                                            </button>
                                        }
                                        </Authorized>
                                </AuthorizeView>

                                <button class="btn btn-sm btn-primary shadow-sm border-0 text-white fw-semibold d-flex align-items-center px-3"
                                        @onclick="ToggleEditMode">
                                    <i class="bi bi-pencil-square me-2"></i> Editar Fase
                                </button>                                    
                            }
                            else
                            {
                                <button class="btn btn-sm btn-light border text-muted fw-semibold px-3 shadow-none" @onclick="CancelEditMode">
                                    Cancelar
                                </button>
                                <button class="btn btn-sm text-white fw-bold px-3 shadow-sm" style="background-color: #198754;" @onclick="SaveChangesBulk">
                                    <i class="bi bi-check-circle me-2"></i> Guardar Alterações
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Mensagem de Validação -->
                    @if (!string.IsNullOrEmpty(validationError))
                    {
                        <div class="alert alert-danger py-2 mb-3 shadow-sm d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Atenção:</strong>&nbsp;@validationError
                        </div>
                    }

                    <!-- Lista de Tarefas -->
                    @if (activeModalModule.Components != null && activeModalModule.Components.Any(c => c.Stage == activeModalStage.Value.Stage))
                    {
                        <div class="list-group mb-4 shadow-sm" style="border-radius: 8px;">
                            @{
                                var stageComponents = activeModalModule.Components.Where(c => c.Stage == activeModalStage.Value.Stage).ToList();
                                var topLevel = stageComponents.Where(c => c.ParentComponentId == null).ToList();
                            }

                            @foreach (var comp in topLevel)
                            {
                                // Salta a renderização se tiver sido "apagado" temporariamente no modo edição
                                @if (editModeDeletedIds.Contains(comp.Id)) continue;

                                var children = stageComponents.Where(c => c.ParentComponentId == comp.Id).ToList();

                                @if (isEditMode)
                                {
                                    <div class="mb-3">
                                        <!-- MODO EDIÇÃO: Pai -->
                                        <div class="d-flex align-items-start mb-2">
                                            <div class="flex-grow-1">
                                                <!-- Removido o disabled -->
                                                <input type="text" class="form-control border-success fw-bold mb-1" @bind="comp.Title" />
                                                @* <span class="badge bg-dark">Template: @comp.IsFromTemplate</span> *@

                                                @if (activeModalStage.Value.Stage == ModuleStage.Teorica)
                                                {
                                                    <!-- Removido o disabled -->
                                                    <textarea class="form-control form-control-sm text-muted mb-1" rows="2" placeholder="Descrição ou instruções..." @bind="comp.Description"></textarea>
                                                    <input class="form-control form-control-sm text-muted" placeholder="Link do Documento..." @bind="comp.PdfFilePath" />
                                                }
                                            </div>

                                            @if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                                            {
                                                <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                    <input type="text" inputmode="numeric" class="form-control text-center px-1" style="width: 30px;" @bind="comp.Weight" />
                                                    <span class="input-group-text px-1">%</span>
                                                </div>
                                            }

                                            <!-- SÓ APAGA SE FOR O TEMPLATE OU SE FOR UM PARÂMETRO NOVO DO ALUNO -->
                                            @if (CurrentMode == BuilderMode.Template || !comp.IsFromTemplate)
                                            {
                                                <button class="btn btn-link text-danger p-0 ms-1 flex-shrink-0" @onclick="() => editModeDeletedIds.Add(comp.Id)"><i class="bi bi-x-lg fs-5"></i></button>
                                            }
                                        </div>

                                        <!-- MODO EDIÇÃO: Filhos Existentes -->
                                        @foreach (var child in children)
                                        {
                                            @if (editModeDeletedIds.Contains(child.Id)) continue;

                                            <div class="d-flex align-items-center ms-4 mb-2">
                                                <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                <input type="text" class="form-control border-dark" @bind="child.Title" />

                                                @if (activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                {
                                                    <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                        <input type="text" inputmode="numeric" class="form-control text-center px-1" style="width: 30px;" @bind="child.Weight" />
                                                        <span class="input-group-text px-1">%</span>
                                                    </div>
                                                }

                                                <!-- CORREÇÃO AQUI -->
                                                @if (CurrentMode == BuilderMode.Template || !child.IsFromTemplate)
                                                {
                                                    <button class="btn btn-link text-danger p-0 ms-1 flex-shrink-0" @onclick="() => editModeDeletedIds.Add(child.Id)"><i class="bi bi-x-lg fs-5"></i></button>
                                                }
                                            </div>
                                        }

                                        <!-- MODO EDIÇÃO: Rascunho para Novos Filhos -->
                                        @if (editModeNewChildren.ContainsKey(comp.Id))
                                        {
                                            @foreach (var newChild in editModeNewChildren[comp.Id])
                                            {
                                                <div class="d-flex align-items-center ms-4 mb-1">
                                                    <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                    <input type="text" class="form-control @(string.IsNullOrWhiteSpace(newChild.Text) ? "draft-empty" : "draft-filled-success")"
                                                           placeholder="Adicionar novo sub-parâmetro..."
                                                           style="@(string.IsNullOrWhiteSpace(newChild.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                                           @bind="newChild.Text"
                                                           @bind:event="oninput"
                                                           @onkeyup="() => CheckEditModeChildrenState(comp.Id)" />

                                                    @if (!string.IsNullOrWhiteSpace(newChild.Text) && activeModalStage.Value.Stage != ModuleStage.Teorica)
                                                    {
                                                        <div class="input-group input-group-sm mx-2 flex-shrink-0" style="width: 80px;">
                                                            <input type="text" inputmode="numeric" class="form-control text-center px-1" @bind="newChild.Weight" />
                                                            <span class="input-group-text px-1">%</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <!-- MODO LEITURA: A grelha limpa -->
                                    bool isTeorica = activeModalStage.Value.Stage == ModuleStage.Teorica;
                                    bool hasDetails = !string.IsNullOrWhiteSpace(comp.Description) || !string.IsNullOrWhiteSpace(comp.PdfFilePath);
                                    bool canExpand = isTeorica && hasDetails;

                                    <div class="list-group-item py-3 border-0 border-bottom bg-light" 
                                         style="@(canExpand ? "cursor: pointer;" : "")" 
                                         @onclick="() => { if (canExpand) expandedComponentId = (expandedComponentId == comp.Id ? null : comp.Id); }">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center pe-3 flex-grow-1">
                                                <i class="bi @(string.IsNullOrEmpty(comp.PdfFilePath) ? (isTeorica ? "bi-journal-text" : "bi-card-text") : "bi-file-earmark-pdf text-danger") fs-5 me-3 @(string.IsNullOrEmpty(comp.PdfFilePath) ? "text-secondary" : "")"></i>
                                                <span class="fw-bold text-dark text-wrap">@comp.Title</span>
                                            </div>
                                            
                                            <!-- Os pesos só aparecem se NÃO for teórica -->
                                            @if (!isTeorica)
                                            {
                                                <div class="d-flex align-items-center gap-1 me-2 pe-2">
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.75rem;">@comp.Weight%</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- ÁREA EXPANSÍVEL DA TEÓRICA -->
                                    @if (expandedComponentId == comp.Id && canExpand)
                                    {
                                        <div class="p-3 bg-white border-bottom border-start border-4 border-primary">
                                            @if (!string.IsNullOrWhiteSpace(comp.Description))
                                            {
                                                <p class="text-muted small mb-2">@comp.Description</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(comp.PdfFilePath))
                                            {
                                                <a href="@comp.PdfFilePath" target="_blank" class="btn btn-sm btn-outline-danger mt-1">
                                                    <i class="bi bi-file-pdf me-1"></i> Ver Ficheiro
                                                </a>
                                            }
                                        </div>
                                    }

                                    @foreach (var child in children)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center py-2 border-0 border-bottom ms-4">
                                            <div class="d-flex align-items-center pe-3 flex-grow-1">
                                                <i class="bi bi-arrow-return-right text-secondary fs-6 me-3 flex-shrink-0"></i>
                                                <span class="fw-semibold text-dark text-wrap" style="font-size: 0.95rem;">@child.Title</span>
                                            </div>

                                            @if (CurrentMode != BuilderMode.Template && activeModalStage.Value.Stage != ModuleStage.Teorica)
                                            {
                                                <div class="d-flex align-items-center gap-1 me-2 pe-2">
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.7rem;">@child.Weight%</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light text-center border mb-4" style="border-radius: 8px;">
                            <span class="text-muted small">Nenhum item adicionado a esta fase.</span>
                        </div>
                    }

                    <!-- Adicionar Novos Componentes -->
                    @if (!isEditMode)
                    {
                        if (activeModalStage.Value.Stage == ModuleStage.Teorica)
                        {
                            <div class="p-4 rounded bg-white shadow-sm mt-4" style="border: 1px dashed #ced4da;">
                            
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold text-primary mb-0">Adicionar Nova Componente Teórica</h6>
                                    <button class="btn btn-sm btn-light border" @onclick="ResetForm">Limpar</button>
                                </div>

                                <div class="mb-3">
                                    <input class="form-control shadow-sm border-0 bg-light fw-bold" placeholder="Título (Ex: Manual de Ventilação)..." @bind="componentToEdit.Title" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">Instruções / Descrição (Opcional)</label>
                                    <textarea class="form-control shadow-sm border-0 bg-light" rows="3" placeholder="Ex: Leiam o capítulo 3..." @bind="componentToEdit.Description"></textarea>
                                </div>

                                <!-- O TEU BLOCO DE UPLOAD AQUI -->
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">URL ou Anexo (Opcional)</label>

                                    <div class="input-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-link-45deg"></i></span>

                                        <input class="form-control border-0 bg-light" placeholder="Ex: https://youtube.com/..." @bind="componentToEdit.PdfFilePath" disabled="@isUploading" />

                                        <label class="btn btn-secondary border-0 m-0 d-flex align-items-center px-3" style="cursor: pointer; background-color: #6A96A6;">
                                            <i class="bi bi-cloud-arrow-up me-2"></i> Explorar...
                                            <InputFile OnChange="HandleFileUpload" class="d-none" accept=".pdf,.doc,.docx" />
                                        </label>
                                    </div>

                                    @if (isUploading)
                                    {
                                        <div class="form-text text-primary small mt-2 d-flex align-items-center fw-semibold">
                                            <div class="spinner-border spinner-border-sm me-2" role="status"></div> A enviar ficheiro para o servidor...
                                        </div>
                                    }
                                </div>
                                <!-- FIM DO TEU BLOCO -->

                                <div class="text-end mt-4">
                                    <button class="btn text-white px-4 shadow-sm" style="background-color: #6A96A6;" @onclick="SaveComponent" disabled="@(isSavingModal || isUploading)">
                                        <i class="bi bi-save me-2"></i> @(isSavingModal ? "A Guardar..." : "Guardar")
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
@*                             @if (CurrentMode != BuilderMode.Template)
                            {
                                <!-- MODO ALUNO: Qualquer supervisor pode adicionar parâmetros ao clone -->
                                @RapidStructureForm
                            }
                            else
                            { *@
                                <!-- MODO MOLDE: Apenas o Admin pode alterar a base -->
                                <AuthorizeView Roles="Admin">
                                    <Authorized Context="AdminAuthContext">
                                        @RapidStructureForm
                                    </Authorized>
                                </AuthorizeView>
                            @* } *@
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}


<!-- ============================================== -->
<!-- MODAL DE CRIAÇÃO AVANÇADA DE MÓDULO            -->
<!-- ============================================== -->
@if (isAddModuleModalOpen)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.6); position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow" style="border-radius: 15px; background-color: #f4f7f6;">

                <div class="modal-header border-bottom-0 pb-2 pt-4 px-4 bg-white" style="border-radius: 15px 15px 0 0;">
                    <h4 class="modal-title fw-bold text-primary"><i class="bi bi-folder-plus me-2"></i>Criar Novo Módulo</h4>
                    <button type="button" class="btn-close" @onclick="CloseAddModuleModal"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <div class="row g-3 mb-4 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted mb-1">Título do Módulo</label>
                            <input type="text" class="form-control fw-bold" placeholder="Ex: UT1 - Introdução..." @bind="advancedModuleTitle" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted text-nowrap mb-1">Peso do Módulo</label>
                            <div class="input-group">
                                <input type="text" class="form-control text-center" @bind="advancedModuleWeight" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 rounded bg-white shadow-sm" style="border: 1px dashed #ced4da;">
                        <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-list-task me-2"></i>Parâmetros Iniciais (Aplicados às 4 Fases)</h6>

                        <div class="d-flex flex-column gap-2 mb-3">
                            @foreach (var parent in drafts)
                            {
                                <div @onfocusin="() => activeDraftParent = parent">
                                    <div class="d-flex align-items-center mb-1">
                                        <input type="text" class="form-control @(string.IsNullOrWhiteSpace(parent.Text) ? "text-muted" : "border-success fw-bold")"
                                               placeholder="Grupo ou Tarefa principal..."
                                               style="@(string.IsNullOrWhiteSpace(parent.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                                               @bind="parent.Text" @bind:event="oninput" @onkeyup="() => CheckListState(parent)" />

                                        @if (!string.IsNullOrWhiteSpace(parent.Text))
                                        {
                                            <div class="input-group input-group-sm ms-2 flex-shrink-0" style="width: 85px;">
                                                <input type="text" class="form-control text-center px-1" placeholder="Peso" @bind="parent.Weight" />
                                                <span class="input-group-text px-1">%</span>
                                            </div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(parent.Text) || parent.Children.Any(f => !string.IsNullOrWhiteSpace(f.Text)))
                                    {
                                        <div class="ms-4 mb-2 d-flex flex-column gap-1">
                                            @foreach (var child in parent.Children)
                                            {
                                                if (!string.IsNullOrWhiteSpace(child.Text) || activeDraftParent == parent)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                        <input type="text" class="form-control form-control-sm @(string.IsNullOrWhiteSpace(child.Text) ? "text-muted" : "border-dark")"
                                                               placeholder="Sub-parâmetro..."
                                                               style="@(string.IsNullOrWhiteSpace(child.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #343a40;")"
                                                               @bind="child.Text" @bind:event="oninput" @onkeyup="() => CheckListState(parent)" />

                                                        @if (!string.IsNullOrWhiteSpace(child.Text))
                                                        {
                                                            <div class="input-group input-group-sm ms-2 flex-shrink-0" style="width: 85px;">

                                                                <input type="text" class="form-control text-center px-1" placeholder="Peso" @bind="child.Weight" />
                                                                <span class="input-group-text px-1">%</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top-0 bg-light" style="border-radius: 0 0 15px 15px;">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-bold" @onclick="CloseAddModuleModal">Cancelar</button>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" @onclick="SaveAdvancedModule" disabled="@isSavingModal">
                        @if (isSavingModal)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar Módulo
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (isWeightModalOpen)
{
    <ModuleWeightManagerModal
        Modules="Modules"
        OnSave="SaveBulkWeights"
        OnCancel="() => isWeightModalOpen = false" />
}

@code {
    private RenderFragment RapidStructureForm => __builder =>
    {
        <div class="p-4 rounded bg-white shadow-sm mt-4" style="border: 1px dashed #ced4da;">
            <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-list-task me-2"></i>Adicionar Parâmetros</h6>
            <div class="d-flex flex-column gap-2 mb-3">
                @foreach (var parent in drafts)
                {
                    <div @onfocusin="() => activeDraftParent = parent">
                        <input type="text" class="form-control mb-1 @(string.IsNullOrWhiteSpace(parent.Text) ? "text-muted" : "border-success fw-bold")"
                               placeholder="Grupo ou Tarefa principal..."
                               style="@(string.IsNullOrWhiteSpace(parent.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #198754;")"
                               @bind="parent.Text" @bind:event="oninput" @onkeyup="() => CheckListState(parent)" />

                        @if (!string.IsNullOrWhiteSpace(parent.Text) || parent.Children.Any(f => !string.IsNullOrWhiteSpace(f.Text)))
                        {
                            <div class="ms-4 mb-2 d-flex flex-column gap-1">
                                @foreach (var child in parent.Children)
                                {
                                    if (!string.IsNullOrWhiteSpace(child.Text) || activeDraftParent == parent)
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                            <input type="text" class="form-control form-control-sm @(string.IsNullOrWhiteSpace(child.Text) ? "text-muted" : "border-dark")"
                                                   placeholder="Sub-parâmetro..."
                                                   style="@(string.IsNullOrWhiteSpace(child.Text) ? "border: 2px dashed #adb5bd !important; background-color: #f8f9fa;" : "border: 2px solid #343a40;")"
                                                   @bind="child.Text" @bind:event="oninput" @onkeyup="() => CheckListState(parent)" />
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            @if (drafts.Any(p => !string.IsNullOrWhiteSpace(p.Text)))
            {
                <div class="text-end mt-2">
                    <button class="btn btn-success px-4 fw-bold shadow-sm" @onclick="SaveRapidStructure" disabled="@isSavingModal">
                        @if (isSavingModal)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar Estrutura
                    </button>
                </div>
            }
        </div>
    };

    #region [ Parâmetros e Eventos (Comunicação com o Pai) ]

    [Parameter] public int PathwayTemplateId { get; set; }    
    [Parameter] public string ParentTitle { get; set; } = string.Empty;
    [Parameter] public List<BuilderModuleDto> Modules { get; set; } = new();
    [Parameter] public EventCallback OnOpenBadges { get; set; }
    [Parameter] public BuilderMode CurrentMode { get; set; } = BuilderMode.Geral;

    [Parameter] public EventCallback<(string Title, float Weight, List<DraftParent> Drafts)> OnCreateAdvancedModule { get; set; }
    [Parameter] public EventCallback<int> OnDeleteModule { get; set; }
    [Parameter] public EventCallback<BuilderModuleDto> OnUpdateModuleWeight { get; set; }
    [Parameter] public EventCallback<(int ModuleId, ModuleStage Stage, DateTime Date, bool IsStart)> OnUpdateTimeline { get; set; }

    [Parameter] public EventCallback<int> OnDeleteComponent { get; set; }
    [Parameter] public EventCallback<(int ModuleId, ModuleStage Stage, List<DraftParent> Drafts)> OnSaveRapidStructureEvent { get; set; }
    [Parameter] public EventCallback<(int ModuleId, BuilderComponentDto Component)> OnSaveTheoreticalEvent { get; set; }
    [Parameter] public EventCallback<(int ModuleId, ModuleStage CurrentStage, ModuleStage SourceStage)> OnCopyComponentsEvent { get; set; }
    [Parameter] public EventCallback<(int ModuleId, ModuleStage Stage, List<BuilderComponentDto> UpdatedComponents, Dictionary<int, List<(string Title, float Weight)>> NewSubTasks)> OnSaveBulkEditEvent { get; set; }

    #endregion

    #region [ Variáveis de Estado UI ]

    private int expandedModuleId = 0;
    private string newModuleTitle = string.Empty;
    private bool isBadgeModalOpen = false;

    // Estado do Modal
    private BuilderModuleDto? activeModalModule;
    private BuilderComponentDto componentToEdit = new();
    private (ModuleStage Stage, string Title, string Icon, ModuleStage? CopyFromStage)? activeModalStage;
    private bool isSavingModal = false;
    private bool isCopying = false;

    // Controlo de Visualização Local
    private int? expandedComponentId = null;

    // Estado do Bulk Edit (Edição em Massa)
    private bool isEditMode = false;
    private string? validationError;
    private Dictionary<int, List<DraftChild>> editModeNewChildren = new();
    private HashSet<int> editModeDeletedIds = new();
    private Dictionary<int, (string Title, string Description, string PdfFilePath, float Weight)> originalComponentStates = new();
    private bool isUploading = false; // Para quando está a fazer upload de ficheiros PDF

    // Estado do Rascunho (Adicionar Nova Estrutura)
    public class DraftParent {
        public string Text { get; set; } = "";
        public float Weight { get; set; } = 0;
        public List<DraftChild> Children { get; set; } = new() { 
            new DraftChild() 
        }; 
    }

    public class DraftChild { 
        public string Text { get; set; } = "";
        public float Weight { get; set; } = 0; 
    }

    private List<DraftParent> drafts = new() { 
        new DraftParent()
    };
    
    private DraftParent? activeDraftParent = null;

    // Definição estática das fases
    private List<(ModuleStage Stage, string Title, string Icon, ModuleStage? CopyFromStage)> stagesToRender = new()
    {
        (ModuleStage.Teorica, "Componente Teórica", "bi-journal-text", null),
        (ModuleStage.ObservacaoPassiva, "Observação Passiva", "bi-eye", null),
        (ModuleStage.ObservacaoParticipada, "Observação Participada", "bi-people", ModuleStage.ObservacaoPassiva),
        (ModuleStage.PraticaAssistida, "Prática Assistida", "bi-person-gear", ModuleStage.ObservacaoParticipada),
        (ModuleStage.PraticaSupervisionada, "Prática Supervisionada", "bi-person-check", ModuleStage.PraticaAssistida)
    };

    private bool isAddModuleModalOpen = false;
    private string advancedModuleTitle = string.Empty;
    private float advancedModuleWeight = 100f;

    #endregion

    #region [ Ciclo de Vida ]

    protected override void OnParametersSet()
    {
        if (activeModalModule != null)
        {
            activeModalModule = Modules.FirstOrDefault(m => m.Id == activeModalModule.Id);
        }
    }

    #endregion

    #region [ Controlo de Módulos e Visuais Base ]

    private void ToggleModule(int moduleId) => expandedModuleId = (expandedModuleId == moduleId) ? 0 : moduleId;

    private async Task HandleDateChange(int moduleId, ModuleStage stage, string? dateStr, bool isStart)
    {
        if (DateTime.TryParse(dateStr, out DateTime newDate))
        {
            await OnUpdateTimeline.InvokeAsync((moduleId, stage, newDate, isStart));
        }
    }

    private int GetModulePercentage(BuilderModuleDto mod)
    {
        if (!Modules.Any()) return 0;
        var total = Modules.Sum(m => Math.Max(1, m.Weight));
        return (int)Math.Round((double)Math.Max(1, mod.Weight) / total * 100);
    }

    private ModuleStageTimelineDto? GetTimeline(BuilderModuleDto mod, ModuleStage stage)
    {
        return mod.StageTimelines?.FirstOrDefault(t => t.Stage == stage);
    }

    #endregion

    #region [ Controlo do Modal e Formulários ]

    private void OpenStageModal(BuilderModuleDto mod, (ModuleStage Stage, string Title, string Icon, ModuleStage? CopyFromStage) stageInfo)
    {
        activeModalModule = mod;
        activeModalStage = stageInfo;
        isEditMode = false;
        validationError = null;
        expandedComponentId = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();
        ResetForm();
    }

    private void CloseStageModal()
    {
        if (isEditMode) CancelEditMode();

        activeModalModule = null;
        activeModalStage = null;
        isEditMode = false;
        validationError = null;
        expandedComponentId = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();
        originalComponentStates.Clear();
        ResetForm();
    }

    private void ResetForm()
    {
        componentToEdit = new BuilderComponentDto();
        drafts = new List<DraftParent> { new DraftParent() };
    }

    private void CheckListState(DraftParent currentParent)
    {
        if (!string.IsNullOrWhiteSpace(drafts.Last().Text)) drafts.Add(new DraftParent());
        else if (drafts.Count > 1 && string.IsNullOrWhiteSpace(drafts[^2].Text))
        {
            if (!drafts[^2].Children.Any(f => !string.IsNullOrWhiteSpace(f.Text))) drafts.RemoveAt(drafts.Count - 2);
        }

        if (!string.IsNullOrWhiteSpace(currentParent.Children.Last().Text)) currentParent.Children.Add(new DraftChild());
        else if (currentParent.Children.Count > 1 && string.IsNullOrWhiteSpace(currentParent.Children[^2].Text))
        {
            currentParent.Children.RemoveAt(currentParent.Children.Count - 2);
        }
    }

    private void CancelEditMode()
    {
        isEditMode = false;
        validationError = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();

        if (activeModalModule != null && activeModalStage.HasValue)
        {
            var stageComponents = activeModalModule.Components.Where(c => c.Stage == activeModalStage.Value.Stage).ToList();
            foreach (var c in stageComponents)
            {
                if (originalComponentStates.TryGetValue(c.Id, out var original))
                {
                    c.Title = original.Title;
                    c.Description = original.Description;
                    c.PdfFilePath = original.PdfFilePath;
                    c.Weight = original.Weight;
                }
            }
        }

        originalComponentStates.Clear();
        ResetForm();
        StateHasChanged();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        StateHasChanged();

        var file = e.File;
        long maxAllowedSize = 10 * 1024 * 1024; // 10 MB limit

        try
        {
            using var content = new MultipartFormDataContent();

            // Read the file from the browser
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            // Send it to our new Backend Vault
            var response = await Http.PostAsync("api/files/upload", content);

            if (response.IsSuccessStatusCode)
            {
                // The backend hands us back the secure API URL
                var secureUrl = await response.Content.ReadAsStringAsync();

                // Automatically fill the text box with the new secure URL! (Trim removes potential extra JSON quotes)
                componentToEdit.PdfFilePath = secureUrl.Trim('"');
            }
            else
            {
                validationError = "Erro ao enviar ficheiro para o servidor.";
                Console.WriteLine("Erro ao enviar ficheiro.");
            }
        }
        catch (Exception ex)
        {
            validationError = "Ocorreu um erro no upload. Verifique o tamanho do ficheiro.";
            Console.WriteLine($"Erro: {ex.Message}");
        }

        isUploading = false;
        StateHasChanged();
    }

    #endregion

    #region [ Module Modal ]

    private void OpenAddModuleModal()
    {
        advancedModuleTitle = string.Empty;
        advancedModuleWeight = 100f;
        drafts = new List<DraftParent> { new DraftParent() };
        isAddModuleModalOpen = true;
        StateHasChanged();
    }

    private void CloseAddModuleModal()
    {
        isAddModuleModalOpen = false;
    }

    private async Task SaveAdvancedModule()
    {
        if (string.IsNullOrWhiteSpace(advancedModuleTitle)) return;
        isSavingModal = true;
        await OnCreateAdvancedModule.InvokeAsync((advancedModuleTitle, advancedModuleWeight, drafts));
        isSavingModal = false;
        isAddModuleModalOpen = false;
    }

    #endregion

    #region [ Processamento de Gravações ]

    private async Task SaveRapidStructure()
    {
        if (activeModalModule == null || !activeModalStage.HasValue) return;
        isSavingModal = true;
        await OnSaveRapidStructureEvent.InvokeAsync((activeModalModule.Id, activeModalStage.Value.Stage, drafts));
        isSavingModal = false;
        ResetForm();
    }

    private async Task SaveComponent()
    {
        if (activeModalModule == null || !activeModalStage.HasValue) return;
        isSavingModal = true;
        componentToEdit.Stage = activeModalStage.Value.Stage;
        await OnSaveTheoreticalEvent.InvokeAsync((activeModalModule.Id, componentToEdit));
        isSavingModal = false;
        ResetForm();
    }

    private async Task CopyComponents()
    {
        if (activeModalModule == null || !activeModalStage.HasValue || !activeModalStage.Value.CopyFromStage.HasValue) return;
        isCopying = true;
        await OnCopyComponentsEvent.InvokeAsync((activeModalModule.Id, activeModalStage.Value.Stage, activeModalStage.Value.CopyFromStage.Value));
        isCopying = false;
    }

    #endregion

    #region [ Edição em Massa (Bulk Edit) ]

    private void ToggleEditMode()
    {
        isEditMode = true;
        validationError = null;
        editModeDeletedIds.Clear();
        editModeNewChildren.Clear();
        originalComponentStates.Clear();

        var stageComponents = activeModalModule?.Components.Where(c => c.Stage == activeModalStage?.Stage).ToList() ?? new();
        var topLevel = stageComponents.Where(c => c.ParentComponentId == null).ToList();

        // 1. Distribuição Automática (Apenas se a soma for 0% - itens recém-criados)
        if (activeModalStage.Value.Stage != ModuleStage.Teorica && topLevel.Any() && topLevel.Sum(c => c.Weight) == 0)
        {
            int wPerItem = 100 / topLevel.Count;
            int remainder = 100 % topLevel.Count;
            for (int i = 0; i < topLevel.Count; i++) topLevel[i].Weight = wPerItem + (i == 0 ? remainder : 0);
        }

        foreach (var c in stageComponents)
        {
            // Fotografia do estado original
            originalComponentStates[c.Id] = (c.Title, c.Description ?? "", c.PdfFilePath ?? "", c.Weight);

            if (c.ParentComponentId == null)
            {
                editModeNewChildren[c.Id] = new List<DraftChild> { new DraftChild() };

                // 2. Distribuição Automática para Filhos (Apenas se a soma for 0%)
                var children = stageComponents.Where(child => child.ParentComponentId == c.Id).ToList();
                if (activeModalStage.Value.Stage != ModuleStage.Teorica && children.Any() && children.Sum(child => child.Weight) == 0)
                {
                    int wPerChild = 100 / children.Count;
                    int childRemainder = 100 % children.Count;
                    for (int i = 0; i < children.Count; i++) children[i].Weight = wPerChild + (i == 0 ? childRemainder : 0);
                }
            }
        }
    }

    private void CheckEditModeChildrenState(int parentId)
    {
        var list = editModeNewChildren[parentId];
        if (!string.IsNullOrWhiteSpace(list.Last().Text)) list.Add(new DraftChild());
        else if (list.Count > 1 && string.IsNullOrWhiteSpace(list[^2].Text)) list.RemoveAt(list.Count - 2);
    }

    private async Task SaveChangesBulk()
    {
        if (activeModalModule == null || !activeModalStage.HasValue) return;

        // Filtramos os que foram apagados temporariamente na validação de pesos
        var componentsToUpdate = activeModalModule.Components
            .Where(c => c.Stage == activeModalStage.Value.Stage && !editModeDeletedIds.Contains(c.Id))
            .ToList();

        var topLevel = componentsToUpdate.Where(c => c.ParentComponentId == null).ToList();

        // VALIDAÇÕES (Apenas se NÃO for componente Teórica)
        if (activeModalStage.Value.Stage != ModuleStage.Teorica)
        {
            if (topLevel.Any() && topLevel.Sum(c => c.Weight) != 100)
            {
                validationError = "A soma das percentagens dos parâmetros principais tem de ser exatamente 100%.";
                return;
            }

            foreach (var parent in topLevel)
            {
                var existingChildren = componentsToUpdate.Where(c => c.ParentComponentId == parent.Id).ToList();
                var newChildren = editModeNewChildren.ContainsKey(parent.Id) ? editModeNewChildren[parent.Id].Where(c => !string.IsNullOrWhiteSpace(c.Text)).ToList() : new();

                var totalWeight = existingChildren.Sum(c => c.Weight) + newChildren.Sum(c => c.Weight);

                if ((existingChildren.Any() || newChildren.Any()) && totalWeight != 100)
                {
                    validationError = $"A soma das percentagens dos sub-parâmetros de '{parent.Title}' tem de ser exatamente 100%.";
                    return;
                }
            }
        }

        // Tudo Validado! Processa Gravação.
        validationError = null;
        isSavingModal = true;

        // Executa as eliminações reais
        foreach (var id in editModeDeletedIds)
        {
            await OnDeleteComponent.InvokeAsync(id);
        }
        editModeDeletedIds.Clear();

        var newSubTasksDict = new Dictionary<int, List<(string Title, float Weight)>>();
        foreach (var kvp in editModeNewChildren)
        {
            // Se o pai foi apagado, não criamos os filhos dele
            if (editModeDeletedIds.Contains(kvp.Key)) continue;

            var validTasks = kvp.Value.Where(c => !string.IsNullOrWhiteSpace(c.Text)).Select(c => (c.Text, c.Weight)).ToList();
            if (validTasks.Any()) newSubTasksDict[kvp.Key] = validTasks;
        }

        await OnSaveBulkEditEvent.InvokeAsync((activeModalModule.Id, activeModalStage.Value.Stage, componentsToUpdate, newSubTasksDict));

        isSavingModal = false;
        isEditMode = false;
    }

    #endregion

    #region [ Controlo de Badges ]

    private void OpenBadgeModal()
    {
        isBadgeModalOpen = true;
        StateHasChanged();
    }

    private void CloseBadgeModal()
    {
        isBadgeModalOpen = false;
    }

    #endregion

    #region [ Weight Modal ]

    // Variável e novo Evento
    private bool isWeightModalOpen = false;
    [Parameter] public EventCallback<List<BuilderModuleDto>> OnUpdateBulkModuleWeights { get; set; }

    private void OpenWeightModal() => isWeightModalOpen = true;

    private async Task SaveBulkWeights(List<BuilderModuleDto> updatedModules)
    {
        isWeightModalOpen = false;
        await OnUpdateBulkModuleWeights.InvokeAsync(updatedModules);
    }

    #endregion
}
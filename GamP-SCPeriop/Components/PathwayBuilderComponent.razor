    #region [ Drag & Drop (Component Sorting) ]

    private int? draggingParentId;
    private int? draggingChildId;

    private string? dropTargetId;

    /// <summary>
    /// Identifies the component (parent or child) currently being dragged.
    /// </summary>
    private void HandleDragStart(int parentId, int? childId = null)
    {
        draggingParentId = parentId;
        draggingChildId = childId;
    }

    /// <summary>
    /// Resets states on successful component drop.
    /// Real-time reordering is handled via HandleDragEnter.
    /// </summary>
    private void HandleDrop()
    {
        ResetDrag();
    }

    /// <summary>
    /// Core utility to swap elements in a generic component list based on Drag & Drop events.
    /// </summary>
    private void ReorderList(List<BuilderComponentDto> list, int draggedId, int targetId)
    {
        var draggedItem = list.FirstOrDefault(c => c.Id == draggedId);
        var targetItem = list.FirstOrDefault(c => c.Id == targetId);

        if (draggedItem == null || targetItem == null || draggedItem == targetItem) return;

        int oldIndex = list.IndexOf(draggedItem);
        int newIndex = list.IndexOf(targetItem);

        list.RemoveAt(oldIndex);
        list.Insert(newIndex, draggedItem);

        for (int i = 0; i < list.Count; i++) list[i].OrderIndex = i;
    }

    /// <summary>
    /// Clears the active component dragging state.
    /// </summary>
    private void ResetDrag()
    {
        draggingParentId = null;
        draggingChildId = null;
    }

    /// <summary>
    /// Handles complex drag-enter logic, ensuring children only swap with children inside the same parent, and parents swap with parents.
    /// </summary>
    private void HandleDragEnter(int targetParentId, int? targetChildId = null)
    {
        if (activeModalModule == null || !activeModalStage.HasValue || draggingParentId == null) return;

        var stageComponents = activeModalModule.Components.Where(c => c.Stage == activeModalStage.Value.Stage).ToList();

        if (draggingChildId.HasValue)
        {
            // Security: Children can only swap places with other children of the same parent
            if (draggingParentId != targetParentId || !targetChildId.HasValue || draggingChildId == targetChildId) return;

            var children = stageComponents.Where(c => c.ParentComponentId == targetParentId).OrderBy(c => c.OrderIndex).ToList();
            ReorderList(children, draggingChildId.Value, targetChildId.Value);
        }
        else
        {
            // Security: Parents can only swap places with other parents
            if (targetChildId.HasValue || draggingParentId == targetParentId) return;

            var parents = stageComponents.Where(c => c.ParentComponentId == null).OrderBy(c => c.OrderIndex).ToList();
            ReorderList(parents, draggingParentId.Value, targetParentId);
        }
    }

    /// <summary>
    /// Clears the drop target UI styling on leave.
    /// </summary>
    private void HandleDragLeave(string targetId)
    {
        if (dropTargetId == targetId) dropTargetId = null;

    #region [ Drag & Drop (Module Sorting) ]

    private int? draggingModuleId;

    /// <summary>
    /// Tracks the identifier of the module currently being dragged.
    /// </summary>
    private void HandleModuleDragStart(int id)
    {
        draggingModuleId = id;
    }

    /// <summary>
    /// Intercepts a dragged module entering a new position and live-updates the array index.
    /// </summary>
    private void HandleModuleDragEnter(int targetId)
    {
        if (draggingModuleId == null || draggingModuleId == targetId) return;

        var draggedItem = Modules.FirstOrDefault(m => m.Id == draggingModuleId);
        var targetItem = Modules.FirstOrDefault(m => m.Id == targetId);

        if (draggedItem == null || targetItem == null) return;

        int oldIndex = Modules.IndexOf(draggedItem);
        int newIndex = Modules.IndexOf(targetItem);

        Modules.RemoveAt(oldIndex);
        Modules.Insert(newIndex, draggedItem);

        for (int i = 0; i < Modules.Count; i++)
        {
            Modules[i].OrderIndex = i;
        }
    }

    /// <summary>
    /// Executes the final drop action and permanently saves the new module ordering to the database.
    /// </summary>
    private async Task HandleModuleDrop()
    {
        ResetModuleDrag();

        try
        {
            foreach (var mod in Modules)
            {
                if (CurrentMode == BuilderMode.Template)
                {
                    var dummyMod = new ModuleTemplate
                    {
                        Id = mod.Id,
                        Title = mod.Title,
                        Weight = mod.Weight,
                        OrderIndex = mod.OrderIndex
                    };
                    await Http.PutAsJsonAsync($"api/ModuleTemplate/{mod.Id}", dummyMod);
                }
                else
                {
                    var dummyMod = new Module
                    {
                        Id = mod.Id,
                        Title = mod.Title,
                        Weight = mod.Weight,
                        OrderIndex = mod.OrderIndex
                    };
                    await Http.PutAsJsonAsync($"api/Module/{mod.Id}", dummyMod);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro a gravar a nova ordem: {ex.Message}");
        }
    }


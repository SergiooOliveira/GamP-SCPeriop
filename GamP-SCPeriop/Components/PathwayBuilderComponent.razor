    /// <summary>
    /// Validates rules, auto-distributes empty percentage fields, and submits the bulk edit payload.
    /// </summary>
    private async Task SaveChangesBulk()
    {
        if (activeModalModule == null || !activeModalStage.HasValue) return;

        // 1. Filter existing components and drafts
        var componentsToUpdate = activeModalModule.Components
            .Where(c => c.Stage == activeModalStage.Value.Stage && !editModeDeletedIds.Contains(c.Id))
            .ToList();

        var topLevel = componentsToUpdate.Where(c => c.ParentComponentId == null).OrderBy(c => c.OrderIndex).ToList();
        var allNewParents = editModeEmptyListParents.Concat(editModeNewParents.Values.SelectMany(x => x)).Where(p => !string.IsNullOrWhiteSpace(p.Text)).ToList();

        // 2. Validations and Auto-Distribution
        if (activeModalStage.Value.Stage != ModuleStage.Teorica)
        {
            // A. Auto-Distribute Parents (Existing and New)
            var emptyExistingParents = topLevel.Where(c => c.Weight <= 0).ToList();
            var emptyNewParents = allNewParents.Where(p => p.Weight == null || p.Weight <= 0).ToList();
            int totalEmptyParents = emptyExistingParents.Count + emptyNewParents.Count;
            float currentSumParents = topLevel.Sum(c => c.Weight) + allNewParents.Where(p => p.Weight > 0).Sum(p => p.Weight ?? 0f);

            if (totalEmptyParents > 0 && currentSumParents < 100)
            {
                float remainder = 100f - currentSumParents;
                float split = (float)Math.Round(remainder / totalEmptyParents, 2);
                int currentIndex = 0;

                foreach (var p in emptyExistingParents) { p.Weight = (currentIndex == totalEmptyParents - 1) ? (float)Math.Round(remainder - (split * currentIndex), 2) : split; currentIndex++; }
                foreach (var p in emptyNewParents) { p.Weight = (currentIndex == totalEmptyParents - 1) ? (float)Math.Round(remainder - (split * currentIndex), 2) : split; currentIndex++; }
            }

            // B. Global Parent Validation
            float totalParentWeight = topLevel.Sum(c => c.Weight) + allNewParents.Sum(p => p.Weight ?? 0f);
            if ((topLevel.Any() || allNewParents.Any()) && totalParentWeight != 100)
            {
                validationError = "A soma das percentagens dos parâmetros principais tem de ser exatamente 100%.";
                return;
            }

            // C. Auto-Distribute and Validate Children
            foreach (var parent in topLevel)
            {
                var existingChildren = componentsToUpdate.Where(c => c.ParentComponentId == parent.Id).ToList();
                var newChildren = editModeNewChildren.ContainsKey(parent.Id) ? editModeNewChildren[parent.Id].Where(c => !string.IsNullOrWhiteSpace(c.Text)).ToList() : new();

                bool hasAdminChildren = existingChildren.Any(c => c.IsFromTemplate);

                if (CurrentMode != BuilderMode.Template && hasAdminChildren)
                {
                    foreach (var nc in newChildren) nc.Weight = 0;
                }
                else
                {
                    var emptyNew = newChildren.Where(c => c.Weight == null).ToList();
                    int totalEmptyCount = emptyNew.Count;
                    float currentSum = existingChildren.Sum(c => c.Weight) + newChildren.Where(c => c.Weight > 0).Sum(c => c.Weight ?? 0f);

                    if (totalEmptyCount > 0 && currentSum < 100)
                    {
                        float remainder = 100f - currentSum;
                        float split = (float)Math.Round(remainder / totalEmptyCount, 2);
                        int currentIndex = 0;

                        foreach (var nc in emptyNew) { nc.Weight = (currentIndex == totalEmptyCount - 1) ? (float)Math.Round(remainder - (split * currentIndex), 2) : split; currentIndex++; }
                    }
                }

                float finalSum = existingChildren.Sum(c => c.Weight) + newChildren.Sum(c => c.Weight ?? 0f);
                if ((existingChildren.Any() || newChildren.Any()) && finalSum != 100 && finalSum != 0)
                {
                    validationError = $"A soma das percentagens dos sub-parâmetros de '{parent.Title}' tem de ser exatamente 100% (ou 0% para descritivos).";
                    return;
                }
            }

            // D. Auto-Distribute and Validate Children (New Parents)
            foreach (var newParent in allNewParents)
            {
                var validChildren = newParent.Children.Where(c => !string.IsNullOrWhiteSpace(c.Text)).ToList();

                if (validChildren.Any())
                {
                    var emptyChildren = validChildren.Where(c => c.Weight == null).ToList();
                    float currentSum = validChildren.Where(c => c.Weight > 0).Sum(c => c.Weight ?? 0f);

                    if (emptyChildren.Any() && currentSum < 100)
                    {
                        float remainder = 100f - currentSum;
                        float split = (float)Math.Round(remainder / emptyChildren.Count, 2);
                        int currentIndex = 0;

                        foreach (var child in emptyChildren)
                        {
                            child.Weight = (currentIndex == emptyChildren.Count - 1) ? (float)Math.Round(remainder - (split * currentIndex), 2) : split;
                            currentIndex++;
                        }
                    }

                    float finalSum = validChildren.Sum(c => c.Weight ?? 0f);
                    if (finalSum != 100 && finalSum != 0)
                    {
                        validationError = $"A soma das percentagens dos sub-parâmetros de '{newParent.Text}' tem de ser exatamente 100% (ou 0% para descritivos).";
                        return;
                    }
                }
            }
        }

        // 3. All validated! Process deletions.
        validationError = null;
        isSavingModal = true;
        foreach (var id in editModeDeletedIds) await OnDeleteComponent.InvokeAsync(id);
        editModeDeletedIds.Clear();

        // 4. Calculate ordering for new parents and their children.
        int currentParentOrder = 0;
        var validNewParents = new List<(string Title, float Weight, int OrderIndex, List<(string Title, float Weight, int OrderIndex)> Children)>();

        foreach (var draft in editModeEmptyListParents.Where(p => !string.IsNullOrWhiteSpace(p.Text) || p.Children.Any(c => !string.IsNullOrWhiteSpace(c.Text))))
        {
            var childrenList = new List<(string Title, float Weight, int OrderIndex)>();
            int childOrder = 0;

            foreach (var c in draft.Children.Where(child => !string.IsNullOrWhiteSpace(child.Text)))
                childrenList.Add((c.Text, c.Weight ?? 0f, childOrder++));

            validNewParents.Add((draft.Text ?? "", draft.Weight ?? 0f, currentParentOrder++, childrenList));
        }

        foreach (var parent in topLevel)
        {
            parent.OrderIndex = currentParentOrder++;
            if (editModeNewParents.TryGetValue(parent.Id, out var draftParents))
            {
                foreach (var draft in draftParents.Where(p => !string.IsNullOrWhiteSpace(p.Text) || p.Children.Any(c => !string.IsNullOrWhiteSpace(c.Text))))
                {
                    var childrenList = new List<(string Title, float Weight, int OrderIndex)>();
                    int childOrder = 0;

                    foreach (var c in draft.Children.Where(child => !string.IsNullOrWhiteSpace(child.Text)))
                        childrenList.Add((c.Text, c.Weight ?? 0f, childOrder++));

                    validNewParents.Add((draft.Text ?? "", draft.Weight ?? 0f, currentParentOrder++, childrenList));
                }
            }
        }

        // 5. Calculate ordering for children.
        var newSubTasksDict = new Dictionary<int, List<(string Title, float Weight, int OrderIndex)>>();
        foreach (var kvp in editModeNewChildren)
        {
            if (editModeDeletedIds.Contains(kvp.Key)) continue;
            int maxChildOrder = componentsToUpdate.Where(c => c.ParentComponentId == kvp.Key).Select(c => c.OrderIndex).DefaultIfEmpty(-1).Max();
            var validTasks = new List<(string Title, float Weight, int OrderIndex)>();

            foreach (var draft in kvp.Value.Where(c => !string.IsNullOrWhiteSpace(c.Text)))
            {
                maxChildOrder++;
                validTasks.Add((draft.Text, draft.Weight ?? 0f, maxChildOrder));
            }
            if (validTasks.Any()) newSubTasksDict[kvp.Key] = validTasks;
        }

        // 6. Emit event.
        await OnSaveBulkEditEvent.InvokeAsync((activeModalModule.Id, activeModalStage.Value.Stage, componentsToUpdate, newSubTasksDict, validNewParents));

        isSavingModal = false;
        isEditMode = false;
    }

    /// <summary>
    /// Distributes remaining percentage weights equally among missing parent/child targets dynamically.
    /// </summary>
    private void ApplyWeightDistribution()
    {
        // 1. Process Parents (Main Tasks)
        var validParents = drafts.Where(p => !string.IsNullOrWhiteSpace(p.Text)).ToList();

        if (validParents.Any())
        {
            // Target ONLY the nulls (empty inputs) and explicit 0s (parents cannot be descriptive)
            var emptyParents = validParents.Where(p => p.Weight == null || p.Weight <= 0).ToList();

            float sumParents = validParents.Where(p => p.Weight > 0).Sum(p => p.Weight.Value);

            // Apply remainder logic if sum is under 100
            if (emptyParents.Any() && sumParents < 100)
            {
                float remainder = 100f - sumParents;
                float split = (float)Math.Round(remainder / emptyParents.Count, 2);

                for (int i = 0; i < emptyParents.Count; i++)
                {
                    // Provide the exact rounding remainder to the final item
                    if (i == emptyParents.Count - 1)
                        emptyParents[i].Weight = (float)Math.Round(remainder - (split * i), 2);
                    else
                        emptyParents[i].Weight = split;
                }
            }

            // 2. Process Children (Sub-parameters) inside each Parent
            foreach (var parent in validParents)
            {
                var validChildren = parent.Children.Where(c => !string.IsNullOrWhiteSpace(c.Text)).ToList();
                if (validChildren.Any())
                {
                    // STRICT FILTER: Target ONLY nulls. Typed 0s are ignored and saved as descriptive.
                    var emptyChildren = validChildren.Where(c => c.Weight == null).ToList();

                    float sumChildren = validChildren.Where(c => c.Weight > 0).Sum(c => c.Weight.Value);

                    if (emptyChildren.Any() && sumChildren < 100)
                    {
                        float remainderChildren = 100f - sumChildren;
                        float splitChildren = (float)Math.Round(remainderChildren / emptyChildren.Count, 2);

                        for (int i = 0; i < emptyChildren.Count; i++)
                        {
                            if (i == emptyChildren.Count - 1)
                                emptyChildren[i].Weight = (float)Math.Round(remainderChildren - (splitChildren * i), 2);
                            else
                                emptyChildren[i].Weight = splitChildren;
                        }
                    }
                }
            }
        }
    }


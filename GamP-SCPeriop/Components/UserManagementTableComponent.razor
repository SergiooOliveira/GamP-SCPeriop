@using GamP_SCPeriop.Shared.Entity.Model
@using GamP_SCPeriop.Shared.Enum
@using GamP_SCPeriop.Shared.Data
@inject IJSRuntime JS
@inject HttpClient Http

<!-- ========================================== -->
<!-- VISAO DO SUPERVISOR                        -->
<!-- ========================================== -->
<AuthorizeView Roles="Supervisor">
    <Authorized>
        <!-- A caixa de pesquisa (agora pertence ao componente) -->
        <div class="row mt-5 mb-4 align-items-center">
            <div class="col-md-6">
                <h4 class="fw-bold mb-0 text-dark">Gestão de Alunos</h4>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="input-group shadow-sm" style="border-radius: 20px; overflow: hidden; max-width: 350px; float: right;">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-0 bg-white" placeholder="Pesquisar aluno..." @bind="searchQuery" @bind:event="oninput">
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-5" style="border-radius: 20px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 fw-bold border-0 py-3">Aluno</th>
                            <th class="fw-bold border-0 py-3">Email</th>
                            <th class="fw-bold border-0 py-3">Percursos Ativos</th>
                            <th class="fw-bold border-0 py-3">Progresso Global</th>
                            <th class="fw-bold border-0 py-3 text-end pe-4">Último Acesso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">A carregar alunos...</td></tr>
                        }
                        else if (!FilteredStudents.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Nenhum aluno encontrado.</td></tr>
                        }
                        else
                        {
                            @foreach (var student in FilteredStudents)
                            {
                                <tr @onclick="() => OnStudentClick.InvokeAsync(student.StudentId)" style="cursor: pointer;" class="bg-white">
                                    <td class="no-select ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle text-white d-flex justify-content-center align-items-center flex-shrink-0 shadow-sm" style="width: 40px; height: 40px; background-color: #1a73e8;">
                                                <i class="bi bi-person-fill fs-5"></i>
                                            </div>
                                            <div class="fw-bold text-dark">@student.FullName</div>
                                        </div>
                                    </td>
                                    <td class="no-select text-muted small">@student.Email</td>
                                    <td>
                                        @if (!student.ActivePathways.Any())
                                        {
                                            <span class="text-muted small">Sem percursos</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var tag in student.ActivePathways)
                                                {
                                                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-normal px-2 py-1 border border-primary border-opacity-25">@tag.Title</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="no-select" style="width: 200px;">
                                        <div class="d-flex align-items-center gap-2 bg-light px-3 py-2" style="border-radius: 20px;">
                                            <div class="bg-white flex-grow-1 shadow-sm" style="height: 6px; border-radius: 10px; overflow: hidden;">
                                                <div class="h-100" style="width: @(student.OverallProgress)%; background-color: #8ab4f8;"></div>
                                            </div>
                                            <small class="fw-bold text-primary" style="min-width: 30px; text-align: right;">@(student.OverallProgress)%</small>
                                        </div>
                                    </td>
                                    <td class="no-select text-end pe-4 text-muted small">
                                        @(student.LastAccess?.ToString("dd MMM yyyy") ?? "-")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </Authorized>
</AuthorizeView>


<!-- ========================================== -->
<!-- VISAO DO ADMIN                             -->
<!-- ========================================== -->
<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="row mt-5 mb-4 align-items-center">
            <div class="col-md-6">
                <h4 class="fw-bold mb-0 text-dark">Lista de Utilizadores no Sistema</h4>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="input-group shadow-sm" style="border-radius: 20px; overflow: hidden; max-width: 350px; float: right;">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-0 bg-white" placeholder="Pesquisar nome, email..." @bind="adminSearchQuery" @bind:event="oninput">
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-5" style="border-radius: 20px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 fw-bold border-0 py-3">Nome Completo</th>
                            <th class="fw-bold border-0 py-3">Email</th>
                            <th class="fw-bold border-0 py-3">Instituição</th>
                            <th class="fw-bold border-0 py-3">Perfil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">A carregar utilizadores...</td></tr>
                        }
                        else if (!FilteredAdminUsers.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Nenhum utilizador encontrado.</td></tr>
                        }
                        else
                        {
                            foreach (var user in FilteredAdminUsers)
                            {
                                <tr class="bg-white" style="cursor: pointer;" @onclick="() => OpenUserProfile(user)">
                                    <td class="ps-4 py-3 fw-bold text-dark">@user.FullName</td>
                                    <td class="text-muted small">@user.Email</td>
                                    <td class="text-muted small">@user.University</td>
                                    <td>
                                        <span class="badge rounded-pill @GetRoleBadgeClass(user.Role) fw-normal px-3 py-1">@user.Role</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (isProfileModalOpen && selectedUser != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-sm" style="border-radius: 12px;">

                        <div class="modal-header border-bottom-0">
                            <h5 class="modal-title fw-bold">Perfil do Utilizador</h5>
                            <button type="button" class="btn-close shadow-none" @onclick="CloseModal"></button>
                        </div>

                        <div class="modal-body px-4 pb-4">
                            <div class="text-center mb-4">
                                <h4 class="fw-bold mb-0">@selectedUser.FullName</h4>
                                <p class="text-muted mb-2">@selectedUser.Email</p>
                                <span class="badge rounded-pill @GetRoleBadgeClass(selectedUser.Role) px-3 py-2">@selectedUser.Role</span>
                            </div>

                            <hr class="text-muted opacity-25" />

                            @if (!showPasswordForm)
                            {
                                <div class="text-center mt-3">
                                    <button class="btn btn-outline-danger" @onclick="() => showPasswordForm = true">
                                        <i class="bi bi-key me-2"></i> Alterar Palavra-passe do Utilizador
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="bg-light p-3 rounded-3 mt-3 border">
                                    <h6 class="fw-bold text-danger mb-3">Definir Nova Palavra-passe</h6>

                                    @if (!string.IsNullOrEmpty(adminErrorMessage))
                                    {
                                        <div class="alert alert-danger py-2 small">@adminErrorMessage</div>
                                    }
                                    @if (!string.IsNullOrEmpty(adminSuccessMessage))
                                    {
                                        <div class="alert alert-success py-2 small">@adminSuccessMessage</div>
                                    }

                                    <div class="mb-2">
                                        <input type="password" class="form-control shadow-none" placeholder="Nova palavra-passe" @bind="resetModel.NewPassword" />
                                    </div>
                                    <div class="mb-3">
                                        <input type="password" class="form-control shadow-none" placeholder="Confirmar nova palavra-passe" @bind="confirmResetPassword" />
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button class="btn btn-secondary w-50" @onclick="() => showPasswordForm = false">Cancelar</button>
                                        <button class="btn btn-danger w-50" @onclick="HandleAdminPasswordReset" disabled="@isResetting">
                                            @if (isResetting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            Guardar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public bool IsLoading { get; set; }

    // --- PARÂMETROS DO SUPERVISOR ---
    [Parameter] public List<StudentManagementDto>? Students { get; set; }
    [Parameter] public EventCallback<int> OnStudentClick { get; set; }

    private string searchQuery = "";
    private IEnumerable<StudentManagementDto> FilteredStudents =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? (Students ?? new())
            : (Students ?? new()).Where(s => s.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                             s.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    // --- PARÂMETROS DO ADMIN ---
    [Parameter] public List<User>? AdminUsers { get; set; }
    [Parameter] public EventCallback<int> OnEditUserClick { get; set; }
    [Parameter] public EventCallback<int> OnDeleteUserClick { get; set; }

    private string adminSearchQuery = "";
    private IEnumerable<User> FilteredAdminUsers =>
        string.IsNullOrWhiteSpace(adminSearchQuery)
            ? (AdminUsers ?? new())
            : (AdminUsers ?? new()).Where(u =>
                (u.FullName != null && u.FullName.Contains(adminSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (u.Email != null && u.Email.Contains(adminSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (u.University != null && u.University.Contains(adminSearchQuery, StringComparison.OrdinalIgnoreCase)));

    private string GetRoleBadgeClass(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => "bg-dark text-white",
            UserRole.Supervisor => "bg-primary text-white",
            UserRole.Supervisionado => "bg-info text-dark",
            _ => "bg-secondary text-dark"
        };
    }

    // ==========================================
    // LÓGICA DO MODAL DO ADMIN
    // ==========================================
    private User? selectedUser = null;
    private bool isProfileModalOpen = false;
    private bool showPasswordForm = false;

    private ResetPasswordDto resetModel = new();
    private string confirmResetPassword = string.Empty;
    private string? adminErrorMessage;
    private string? adminSuccessMessage;
    private bool isResetting = false;

    private void OpenUserProfile(User user)
    {
        selectedUser = user;
        isProfileModalOpen = true;
        showPasswordForm = false;
        adminErrorMessage = null;
        adminSuccessMessage = null;
    }

    private void CloseModal()
    {
        isProfileModalOpen = false;
        selectedUser = null;
    }

    private async Task HandleAdminPasswordReset()
    {
        if (string.IsNullOrWhiteSpace(resetModel.NewPassword) || resetModel.NewPassword != confirmResetPassword)
        {
            adminErrorMessage = "As palavras-passe não coincidem ou estão vazias.";
            return;
        }

        adminErrorMessage = null;
        adminSuccessMessage = null;
        isResetting = true;
        StateHasChanged();

        try
        {
            resetModel.UserId = selectedUser!.Id;

            // SUBSTITUI PELA TUA CHAVE (a mesma que usaste no Settings.razor)
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            var requestMessage = new HttpRequestMessage(HttpMethod.Post, "api/auth/reset-password");
            requestMessage.Content = JsonContent.Create(resetModel);

            if (!string.IsNullOrEmpty(token))
            {
                token = token.Replace("\"", "");
                requestMessage.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.SendAsync(requestMessage);

            if (response.IsSuccessStatusCode)
            {
                adminSuccessMessage = "Palavra-passe alterada com sucesso!";
                resetModel = new ResetPasswordDto();
                confirmResetPassword = string.Empty;

                // Fecha o sub-formulário após 2 segundos (mantendo o modal principal aberto)
                await Task.Delay(2000);
                showPasswordForm = false;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    // Tenta converter a resposta para JSON
                    using var json = System.Text.Json.JsonDocument.Parse(errorContent);

                    // Verifica se existe a secção de "errors" padrão do .NET
                    if (json.RootElement.TryGetProperty("errors", out var errors))
                    {
                        // Vai buscar a primeira mensagem limpa do primeiro erro que a API devolveu
                        adminErrorMessage = errors.EnumerateObject().First().Value[0].GetString();
                    }
                    else if (json.RootElement.TryGetProperty("title", out var title))
                    {
                        // Caso seja um erro mais genérico
                        adminErrorMessage = title.GetString();
                    }
                }
                catch
                {
                    // Se a resposta não for um JSON (por exemplo, texto simples), mostra como antes
                    adminErrorMessage = errorContent;
                }
            }
        }
        catch (Exception)
        {
            adminErrorMessage = "Erro ao comunicar com o servidor.";
        }
        finally
        {
            isResetting = false;
            StateHasChanged();
        }
    }
}
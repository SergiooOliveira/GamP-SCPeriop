@using GamP_SCPeriop.Shared.Data.Template
@using GamP_SCPeriop.Shared.Entity.Model
@using GamP_SCPeriop.Shared.Enum
@inject HttpClient Http

<div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow" style="height: 650px; overflow: hidden;">

            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">
                    @ModalTitle
                </h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-0 d-flex flex-column" style="overflow: hidden;">

                @if (!isCreating)
                {
                    <!-- ESTADO 1: LISTA -->
                    <div class="p-4 flex-grow-1" style="overflow-y: auto;">
                        <div class="mb-4">
                            
                            @if (!existingBadges.Any())
                            {
                                <div class="alert alert-light text-center text-muted" role="alert">
                                    Ainda não existem badges configuradas para este template.
                                </div>
                            }
                            else
                            {
                                <div class="badge-list mt-3">
                                    @foreach (var badge in existingBadges)
                                    {
                                        <div class="d-flex align-items-center justify-content-between py-3 border-bottom">

                                            <!-- Left Side: Icon and Name -->
                                            <div class="d-flex align-items-center">
                                                
                                                <!-- Badge Icon -->
                                                <i class="bi @badge.Icon fs-4 text-warning me-3"></i>

                                                <!-- Badge Name -->
                                                <span class="fw-bold text-dark">@badge.Name</span>

                                            </div>

                                            <!-- Right Side: Rarity and Edit Button -->
                                            <div class="d-flex align-items-center">

                                                <!-- Badge rarity -->
                                                <span class="badge me-3 shadow-sm"
                                                      style="background-color: @(GetTierColor(badge.Tier) + "15"); color: @GetTierColor(badge.Tier); border: 1px solid @(GetTierColor(badge.Tier) + "50");">
                                                    <i class="bi bi-stars me-1"></i>@badge.Tier.ToString()
                                                </span>

                                                <!-- Edit button -->
                                                <button class="btn btn-sm btn-outline-secondary me-2" title="Editar Badge" @onclick="() => EditBadge(badge)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                <!-- Delete button -->
                                                <button class="btn btn-sm btn-outline-danger" title="Apagar Badge" @onclick="() => DeleteBadge(badge.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </div>

                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Botão Fixo no Fundo -->
                    <div class="w-100 bg-white border-top p-3 d-flex justify-content-end mt-auto">
                        <button class="btn btn-primary px-4" @onclick="OpenCreateMode">
                            <i class="bi bi-plus-lg me-2"></i> Adicionar Nova Badge
                        </button>
                    </div>
                }
                else
                {
                    <!-- ESTADO 2: CRIAÇÃO -->
                    <div class="row m-0 flex-grow-1" style="overflow: hidden;">

                        <!-- Coluna da Esquerda: Formulário -->
                        <div class="col-md-7 p-4 border-end" style="height: 100%; overflow-y: auto;">

                            <h6 class="fw-bold text-dark mb-4"><i class="bi bi-stars text-muted me-2"></i>Detalhes da Badge</h6>

                            <!-- 1. ÍCONE PRIMEIRO -->
                            <div class="mb-4">
                                <label class="form-label small fw-semibold text-muted mb-2">1. Escolher Ícone</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var icon in availableIcons)
                                    {
                                        <button type="button"
                                                class="btn border-0 shadow-sm d-flex align-items-center justify-content-center transition-all"
                                                style="width: 45px; height: 45px; border-radius: 12px;
                                                background-color: @(newBadge.Icon == icon ? GetTierColor(newBadge.Tier) + "20" : "#f8f9fa");
                                                color: @(newBadge.Icon == icon ? GetTierColor(newBadge.Tier) : "#6c757d");
                                                transform: @(newBadge.Icon == icon ? "scale(1.1)" : "scale(1)");"
                                                @onclick="() => newBadge.Icon = icon">
                                            <i class="bi @icon fs-5"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- 2. TÍTULO E DESCRIÇÃO -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">2. Título da Badge</label>
                                <input class="form-control bg-light border-0 shadow-sm" placeholder="Ex: Mestre da Ventilação" @bind="newBadge.Name" @bind:event="oninput" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold text-muted">3. Mensagem de Parabéns</label>
                                <textarea class="form-control bg-light border-0 shadow-sm" rows="3" placeholder="Ex: Parabéns por concluíres com sucesso..." @bind="newBadge.Description" @bind:event="oninput"></textarea>
                            </div>

                            <!-- REGRA DE DESBLOQUEIO DINÂMICA -->
                            <div class="mb-5 pb-3 border-top pt-4">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-unlock text-muted me-2"></i>Condição e Raridade</h6>

                                <!-- Selector de Regra e Display de Raridade Lado a Lado -->
                                <div class="row mb-3 align-items-end">
                                    <div class="col-md-8 mb-2 mb-md-0">
                                        <label class="form-label small fw-semibold text-muted">Tipo de Desbloqueio</label>
                                        <select class="form-select bg-light border-0 shadow-sm fw-semibold text-dark" value="@newBadge.TriggerType" @onchange="OnRuleChanged">
                                            <option value="@BadgeTriggerType.ModuleCompletion">Ao concluir um Módulo específico</option>
                                            <option value="@BadgeTriggerType.ExcellenceGrade">Ao atingir nota de Excelência</option>
                                            <option value="@BadgeTriggerType.SpeedFocus">Foco e Velocidade (Dias)</option>
                                            <option value="@BadgeTriggerType.PathwayMilestone">Ao concluir todo o Percurso</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <!-- Display Automático da Raridade (Apenas Leitura) -->
                                        <label class="form-label small fw-semibold text-muted mb-2">Raridade Gerada</label>
                                        <div>
                                            <span class="badge w-100 py-2 fs-6 shadow-sm border"
                                                  style="background-color: @(GetTierColor(newBadge.Tier) + "15"); color: @GetTierColor(newBadge.Tier); border-color: @(GetTierColor(newBadge.Tier) + "50") !important;">
                                                <i class="bi bi-stars me-1"></i>@newBadge.Tier.ToString()
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Escolhas Dinâmicas: O 'TriggerValue' guarda o resultado de qualquer uma delas! -->
                                @if (newBadge.TriggerType == BadgeTriggerType.ModuleCompletion)
                                {
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-muted">Qual é o Módulo?</label>
                                        <select class="form-select bg-light border-0 shadow-sm" @bind="newBadge.TriggerValue">
                                            <option value="">Selecione o Módulo...</option>
                                            @if (AvailableModules != null)
                                            {
                                                @foreach (var mod in AvailableModules)
                                                {
                                                    <option value="@mod.Id">@mod.Title</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                }

                                @if (newBadge.TriggerType == BadgeTriggerType.ExcellenceGrade)
                                {
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-muted">Nota Mínima (%)</label>
                                        <div class="input-group shadow-sm" style="width: 140px;">
                                            <input type="number" class="form-control bg-light border-0 text-center fw-bold" @bind="newBadge.TriggerValue" min="50" max="100" />
                                            <span class="input-group-text bg-white border-0 fw-bold">%</span>
                                        </div>
                                    </div>
                                }

                                @if (newBadge.TriggerType == BadgeTriggerType.SpeedFocus)
                                {
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-muted">Concluir Percurso em menos de:</label>
                                        <div class="input-group shadow-sm" style="width: 160px;">
                                            <input type="number" class="form-control bg-light border-0 text-center fw-bold" @bind="newBadge.TriggerValue" min="1" />
                                            <span class="input-group-text bg-white border-0 fw-bold">Dias</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Coluna da Direita: Pré-visualização -->
                        <div class="col-md-5 bg-light p-4 d-flex flex-column align-items-center justify-content-center" style="height: 100%; border-radius: 0 0 15px 0;">
                            <span class="text-muted small mb-4 text-uppercase fw-bold" style="letter-spacing: 1px;">Pré-visualização</span>

                            <!-- Cartão de Badge com Fundo Dinâmico baseado na Raridade -->
                            <div class="card border-0 shadow text-center p-4 position-relative"
                                 style="width: 260px; border-radius: 20px; transition: all 0.3s ease; background: @GetTierBackground(newBadge.Tier); border-top: 6px solid @GetTierColor(newBadge.Tier) !important;">

                                <span class="badge position-absolute top-0 end-0 m-3 shadow-sm" style="background-color: @GetTierColor(newBadge.Tier);">@newBadge.Tier.ToString()</span>

                                <div class="mx-auto mb-3 mt-2 d-flex align-items-center justify-content-center shadow-sm bg-white" style="@PreviewCircleStyle">
                                    <i class="bi @PreviewIconClass" style="@PreviewIconStyle"></i>
                                </div>

                                <h5 class="fw-bold text-dark mb-2">@PreviewTitle</h5>
                                <p class="text-muted small mb-0" style="line-height: 1.4;">@PreviewDescription</p>
                            </div>
                        </div>
                    </div>

                    <!-- Botões de Ação do Form -->
                    <div class="w-100 bg-white border-top p-3 d-flex justify-content-between mt-auto">
                        <button class="btn btn-light" @onclick="CloseCreateMode">Cancelar</button>
                        <button class="btn btn-success px-4" @onclick="SaveBadge">Guardar Badge</button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {

    #region [ Parameters & Properties ]

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public List<BuilderModuleDto> AvailableModules { get; set; } = new();
    [Parameter] public int CurrentPathwayTemplateId { get; set; }

    #endregion

    #region [ UI State Variables ]

    private bool isCreating = false;
    private bool isEditing = false; // Tracks if the modal is editing an existing badge
    private int? editingBadgeId = null; // Tracks the ID of the badge being edited
    private BadgeTemplateCreateDto newBadge = new();
    private List<BadgeTemplate> existingBadges = new();

    #endregion

    #region [ Lifecycle Methods ]

    protected override async Task OnInitializedAsync()
    {
        await LoadBadges();
    }

    #endregion

    #region [ Enums & Color Helpers ]

    /// <summary>
    /// Returns the hex color code for the border, text, and icons based on the badge's rarity tier.
    /// </summary>
    private string GetTierColor(BadgeTier tier) => tier switch
    {
        BadgeTier.Common => "#7f8c8d",
        BadgeTier.Uncommon => "#2ecc71",
        BadgeTier.Rare => "#3498db",
        BadgeTier.Epic => "#9b59b6",
        BadgeTier.Legendary => "#f1c40f",
        _ => "#7f8c8d"
    };

    /// <summary>
    /// Returns a CSS gradient background string for the preview card based on the badge's rarity tier.
    /// </summary>
    private string GetTierBackground(BadgeTier tier) => tier switch
    {
        BadgeTier.Common => "linear-gradient(135deg, #ffffff 0%, #f1f2f6 100%)",
        BadgeTier.Uncommon => "linear-gradient(135deg, #ffffff 0%, #e8f8f5 100%)",
        BadgeTier.Rare => "linear-gradient(135deg, #ffffff 0%, #ebf5fb 100%)",
        BadgeTier.Epic => "linear-gradient(135deg, #ffffff 0%, #f4ecf8 100%)",
        BadgeTier.Legendary => "linear-gradient(135deg, #ffffff 0%, #fef9e7 100%)",
        _ => "#ffffff"
    };

    /// <summary>
    /// Returns the appropriate modal title based on the current UI state.
    /// </summary>
    private string ModalTitle => isCreating
        ? (isEditing ? "Editar Badge" : "Criar Nova Badge")
        : "Badges do Template";

    #endregion

    #region [ Preview Styles ]

    private string PreviewCircleStyle => $"width: 90px; height: 90px; border-radius: 50%; border: 3px solid {GetTierColor(newBadge.Tier)};";
    private string PreviewIconClass => string.IsNullOrWhiteSpace(newBadge.Icon) ? "bi-award-fill" : newBadge.Icon;
    private string PreviewIconStyle => $"font-size: 2.5rem; color: {GetTierColor(newBadge.Tier)};";
    private string PreviewTitle => string.IsNullOrWhiteSpace(newBadge.Name) ? "Título da Badge" : newBadge.Name;
    private string PreviewDescription => string.IsNullOrWhiteSpace(newBadge.Description) ? "A descrição que o aluno vai ler ao desbloquear aparecerá aqui." : newBadge.Description;

    #endregion

    #region [ Events & Core Logic ]

    /// <summary>
    /// Handles changes to the unlock rule dropdown, updating the underlying logic and auto-generating rarity.
    /// </summary>
    private void OnRuleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<BadgeTriggerType>(e.Value?.ToString(), out var selectedTrigger))
        {
            newBadge.TriggerType = selectedTrigger;
            newBadge.TriggerValue = ""; // Limpa o valor anterior para evitar lixo

            // Auto-define a raridade baseada na dificuldade da regra
            newBadge.Tier = newBadge.TriggerType switch
            {
                BadgeTriggerType.ModuleCompletion => BadgeTier.Uncommon,
                BadgeTriggerType.ExcellenceGrade => BadgeTier.Epic,
                BadgeTriggerType.SpeedFocus => BadgeTier.Rare,
                BadgeTriggerType.PathwayMilestone => BadgeTier.Legendary,
                _ => BadgeTier.Common
            };
        }
    }

    /// <summary>
    /// Closes the entire badge manager modal.
    /// </summary>
    private async Task CloseModal() => await OnClose.InvokeAsync();

    /// <summary>
    /// Resets the form and opens the creation view for a completely new badge.
    /// </summary>
    private void OpenCreateMode()
    {
        isEditing = false;
        editingBadgeId = null;
        newBadge = new BadgeTemplateCreateDto();

        // Ensure default Tier matches the default TriggerType (ModuleCompletion)
        newBadge.TriggerType = BadgeTriggerType.ModuleCompletion;
        newBadge.Tier = BadgeTier.Uncommon;

        isCreating = true;
    }

    /// <summary>
    /// Loads an existing badge's data into the creation form and switches to edit mode.
    /// </summary>
    private void EditBadge(BadgeTemplate badge)
    {
        isEditing = true;
        editingBadgeId = badge.Id;

        newBadge = new BadgeTemplateCreateDto
        {
            PathwayTemplateId = badge.PathwayTemplateId,
            Name = badge.Name,
            Description = badge.Description,
            Icon = badge.Icon,
            TriggerType = badge.TriggerType,
            TriggerValue = badge.TriggerValue,
            Tier = badge.Tier // Preserves the exact Tier from the database
        };

        isCreating = true;
    }

    /// <summary>
    /// Returns to the list view, discarding any active creation or edit states.
    /// </summary>
    private void CloseCreateMode()
    {
        isCreating = false;
        isEditing = false;
        editingBadgeId = null;
    }

    /// <summary>
    /// Fetches all existing badges for the current pathway template from the API.
    /// </summary>
    private async Task LoadBadges()
    {
        try
        {
            var badges = await Http.GetFromJsonAsync<List<BadgeTemplate>>($"api/BadgeTemplate/pathway/{CurrentPathwayTemplateId}");

            // Se a lista vier vazia, abre em modo de criação automaticamente
            if (badges == null || !badges.Any())
            {
                OpenCreateMode();
            }
            else
            {
                existingBadges = badges.OrderBy(b => b.Tier).ToList();
                isCreating = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar badges: {ex.Message}");
        }
    }

    /// <summary>
    /// Submits the badge data to the API, using either POST for creation or PUT for updates.
    /// </summary>
    private async Task SaveBadge()
    {
        try
        {
            newBadge.PathwayTemplateId = CurrentPathwayTemplateId;

            HttpResponseMessage response;

            if (isEditing && editingBadgeId.HasValue)
            {
                // Editar Badge Existente (PUT)
                response = await Http.PutAsJsonAsync($"api/badgetemplate/{editingBadgeId.Value}", newBadge);
            }
            else
            {
                // Criar Nova Badge (POST)
                response = await Http.PostAsJsonAsync("api/badgetemplate", newBadge);
            }

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Badge guardada com sucesso!");
                newBadge = new BadgeTemplateCreateDto();
                isCreating = false;
                isEditing = false;
                editingBadgeId = null;
                await LoadBadges();
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Erro ao guardar a badge. Status: {response.StatusCode}");
                Console.WriteLine($"Detalhes do Backend: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro crítico: {ex.Message}");
        }
    }

    /// <summary>
    /// Deletes a badge by its ID, calling the API and refreshing the list upon success.
    /// </summary>
    private async Task DeleteBadge(int badgeId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/badgetemplate/{badgeId}");

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Badge apagada com sucesso!");
                await LoadBadges();
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Erro ao apagar a badge. Status: {response.StatusCode}");
                Console.WriteLine($"Detalhes: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro crítico ao apagar: {ex.Message}");
        }
    }

    #endregion

    #region [ Static Data ]

    private List<string> availableIcons = new()
    {
        "bi-award-fill", "bi-star-fill", "bi-trophy-fill", "bi-medal-fill",
        "bi-patch-check-fill", "bi-shield-fill-check", "bi-heart-fill",
        "bi-lightning-fill", "bi-gem", "bi-book-fill", "bi-check-circle-fill",
        "bi-fire", "bi-magic", "bi-mortarboard-fill", "bi-person-arms-up"
    };

    #endregion

}
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_Avaliacao" targetNamespace="http://bpmn.io/schema/bpmn" exporter="GamP-SCPeriop relatorio" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Proc_Avaliacao">
    <bpmn:participant id="Pool_Proc_Avaliacao" name="GamP-SCPeriop" processRef="Proc_Avaliacao" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Avaliacao" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_Avaliacao">
      <bpmn:lane id="Lane_Proc_Avaliacao_0" name="Supervisor">
        <bpmn:flowNodeRef>Inicio_Sessao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AbrirFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Classificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Guardar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proc_Avaliacao_1" name="Sistema">
        <bpmn:flowNodeRef>S_Registar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Recalcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Modulo65</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_BadgeModulo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Juntar1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Percurso100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_BadgePercurso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Juntar2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Notificar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proc_Avaliacao_2" name="Supervisionado">
        <bpmn:flowNodeRef>T_Consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_Consultado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_Sessao" name="Sessão prática concluída">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_AbrirFicha" name="Abrir a ficha de avaliação do aluno">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Classificar" name="Classificar componentes por módulo e fase">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Guardar" name="Guardar a avaliação">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_Registar" name="Registar as avaliações">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Recalcular" name="Recalcular o progresso do percurso e dos módulos">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Modulo65" name="Módulo a 65% e com badge?">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_BadgeModulo" name="Atribuir badge de módulo e notificar">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Juntar1">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Percurso100" name="Percurso a 100%?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_BadgePercurso" name="Atribuir badge de percurso e notificar">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Juntar2">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Notificar" name="Notificar a atualização da avaliação">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Consultar" name="Consultar progresso e conquistas">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Fim_Consultado" name="Progresso consultado">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Inicio_Sessao" targetRef="T_AbrirFicha" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_AbrirFicha" targetRef="T_Classificar" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_Classificar" targetRef="T_Guardar" />
    <bpmn:sequenceFlow id="F04" sourceRef="T_Guardar" targetRef="S_Registar" />
    <bpmn:sequenceFlow id="F05" sourceRef="S_Registar" targetRef="S_Recalcular" />
    <bpmn:sequenceFlow id="F06" sourceRef="S_Recalcular" targetRef="Gw_Modulo65" />
    <bpmn:sequenceFlow id="F07" name="sim" sourceRef="Gw_Modulo65" targetRef="S_BadgeModulo" />
    <bpmn:sequenceFlow id="F08" name="não" sourceRef="Gw_Modulo65" targetRef="Gw_Juntar1" />
    <bpmn:sequenceFlow id="F09" sourceRef="S_BadgeModulo" targetRef="Gw_Juntar1" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Juntar1" targetRef="Gw_Percurso100" />
    <bpmn:sequenceFlow id="F11" name="sim" sourceRef="Gw_Percurso100" targetRef="S_BadgePercurso" />
    <bpmn:sequenceFlow id="F12" name="não" sourceRef="Gw_Percurso100" targetRef="Gw_Juntar2" />
    <bpmn:sequenceFlow id="F13" sourceRef="S_BadgePercurso" targetRef="Gw_Juntar2" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gw_Juntar2" targetRef="S_Notificar" />
    <bpmn:sequenceFlow id="F15" sourceRef="S_Notificar" targetRef="T_Consultar" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_Consultar" targetRef="Fim_Consultado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Proc_Avaliacao">
    <bpmndi:BPMNPlane id="Plane_Proc_Avaliacao" bpmnElement="Collab_Proc_Avaliacao">
      <bpmndi:BPMNShape id="Pool_Proc_Avaliacao_di" bpmnElement="Pool_Proc_Avaliacao" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2060" height="450" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Proc_Avaliacao_0_di" bpmnElement="Lane_Proc_Avaliacao_0" isHorizontal="true">

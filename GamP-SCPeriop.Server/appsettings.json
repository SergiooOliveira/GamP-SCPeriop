{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets are NOT stored here (this file is public on GitHub and is overwritten on every deploy).
  // On the server, put them in appsettings.Production.json next to the app (never committed):
  //   { "ConnectionStrings": { "DefaultConnection": "..." }, "Jwt": { "Key": "<openssl rand -base64 48>" } }
  // or in environment variables: ConnectionStrings__DefaultConnection and Jwt__Key.
  "Jwt": {
    "Issuer": "GamP-Server",
    "Audience": "GamP-Client"
  }
}
